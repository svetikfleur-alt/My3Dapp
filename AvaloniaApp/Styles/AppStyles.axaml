<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Toolbar buttons -->
    <Style Selector="Button.toolbar-btn">
        <Setter Property="Background"   Value="#1A2A4A" />
        <Setter Property="Foreground"   Value="#B0C8E8" />
        <Setter Property="BorderBrush"  Value="#2A3F5F" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding"      Value="8,4" />
        <Setter Property="FontSize"     Value="12" />
        <Setter Property="Cursor"       Value="Hand" />
    </Style>
    <Style Selector="Button.toolbar-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#2A3F6F" />
    </Style>
    <Style Selector="Button.toolbar-btn:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#0F3460" />
    </Style>

    <!-- AI action button -->
    <Style Selector="Button.ai-btn">
        <Setter Property="Background"  Value="#4A2080" />
        <Setter Property="Foreground"  Value="#E8D0FF" />
        <Setter Property="BorderBrush" Value="#6A30B0" />
        <Setter Property="FontWeight"  Value="SemiBold" />
    </Style>
    <Style Selector="Button.ai-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#6030A0" />
    </Style>

    <!-- AI send button -->
    <Style Selector="Button.ai-send-btn">
        <Setter Property="Background"       Value="#4A2080" />
        <Setter Property="Foreground"       Value="White" />
        <Setter Property="CornerRadius"     Value="6" />
        <Setter Property="Padding"          Value="0,8" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FontWeight"       Value="SemiBold" />
        <Setter Property="Cursor"           Value="Hand" />
    </Style>
    <Style Selector="Button.ai-send-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#6030A0" />
    </Style>

    <!-- Viewport overlay icon buttons -->
    <Style Selector="Button.viewport-btn">
        <Setter Property="Background"     Value="#1A2A4A88" />
        <Setter Property="Foreground"     Value="#8899BB" />
        <Setter Property="BorderBrush"    Value="#2A3F5F" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"   Value="4" />
        <Setter Property="Width"          Value="28" />
        <Setter Property="Height"         Value="28" />
        <Setter Property="FontSize"       Value="14" />
        <Setter Property="Padding"        Value="0" />
        <Setter Property="Cursor"         Value="Hand" />
    </Style>

    <!-- Small icon button (feature tree +) -->
    <Style Selector="Button.icon-btn">
        <Setter Property="Background"     Value="Transparent" />
        <Setter Property="Foreground"     Value="#6688AA" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding"        Value="4,0" />
        <Setter Property="Cursor"         Value="Hand" />
        <Setter Property="FontSize"       Value="16" />
        <Setter Property="FontWeight"     Value="Light" />
    </Style>

</Styles>
