<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:My3DApp.AvaloniaApp.ViewModels"
        xmlns:controls="clr-namespace:My3DApp.AvaloniaApp.Controls"
        xmlns:services="clr-namespace:My3DApp.AvaloniaApp.Services"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia"
        x:Class="My3DApp.AvaloniaApp.MainWindow"
        x:DataType="vm:StudioShellViewModel"
        Width="1680"
        Height="980"
        MinWidth="1280"
        MinHeight="760"
        Title="{Binding WindowTitle}"
        mc:Ignorable="d">
  <DockPanel LastChildFill="True" Background="{DynamicResource Studio.WindowBackgroundBrush}">
    <Border DockPanel.Dock="Top"
            Classes="StudioTopChrome"
            Background="{DynamicResource Studio.ToolbarBackgroundBrush}"
            BorderBrush="{DynamicResource Studio.BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="14,12,14,10">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto">
        <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
          <Border Classes="StudioBrandMark">
            <TextBlock Text="M3"
                       Classes="StudioBrandMarkText" />
          </Border>

          <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="2" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBox Text="{Binding DocumentName, Mode=TwoWay}"
                       Classes="DocumentTitleEdit"
                       MinWidth="220"
                       MaxWidth="440"
                       HorizontalAlignment="Left"
                       ToolTip.Tip="Document name" />
              <TextBlock Text="•"
                         Classes="ToolbarSubtleText"
                         FontSize="14"
                         VerticalAlignment="Center"
                         IsVisible="{Binding HasUnsavedChanges}"
                         ToolTip.Tip="Unsaved changes" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{Binding StatusBarText}"
                         Classes="ToolbarSubtleText"
                         MaxWidth="520"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding RecoveryStatusLabel}"
                         Classes="ToolbarMetaLabel"
                         VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Grid>

        <Border Grid.Column="1"
                HorizontalAlignment="Center"
                Classes="ModeSwitchShell"
                Padding="4">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <ToggleButton x:Name="Workspace3DButton"
                          Content="3D"
                          IsChecked="{Binding IsThreeDMode, Mode=OneWay}"
                          Classes="ModeToggleButton WorkspaceModeButton"
                          ToolTip.Tip="Return to 3D workspace"
                          Click="OnWorkspace3DClick" />
            <ToggleButton x:Name="WorkspaceSketchButton"
                          Content="Sketch"
                          IsChecked="{Binding IsSketchMode, Mode=OneWay}"
                          Classes="ModeToggleButton WorkspaceModeButton"
                          ToolTip.Tip="Start or finish sketch workflow"
                          Click="OnWorkspaceSketchClick" />
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="{Binding AppVersionLabel}"
                     Classes="ToolbarMetaLabel"
                     VerticalAlignment="Center" />
          <Border Classes="ToolbarModeChip">
            <TextBlock Text="{Binding WorkspaceModeBadge}" Classes="ToolbarModeChipText" />
          </Border>

          <Border Classes="ModeSwitchShell" Padding="4">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ToggleButton x:Name="LightThemeButton"
                            Content="Light"
                            Classes="ModeToggleButton ThemeToggleButton"
                            Click="OnLightThemeClick" />
              <ToggleButton x:Name="DarkThemeButton"
                            Content="Dark"
                            Classes="ModeToggleButton ThemeToggleButton"
                            Click="OnDarkThemeClick" />
            </StackPanel>
          </Border>

          <Button Classes="CommandButton"
                  Content="Commands - Ctrl+K"
                  Click="OnCommandPaletteClick" />
        </StackPanel>

        <Border Grid.Row="1"
                Grid.ColumnSpan="3"
                Classes="ToolbarCommandStrip"
                Margin="0,12,0,0">
          <Grid>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="True">
            <Button Content="File" Classes="ToolbarMenuButton">
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem x:Name="FileNewMenuItem" Header="New Project..." Click="OnNewProjectDialogClick" />
                  <MenuItem Header="New Large Project" Click="OnNewLargeProjectClick" />
                  <MenuItem Header="New Standard Project" Click="OnNewStandardProjectClick" />
                  <MenuItem Header="New Quick Design" Click="OnNewQuickDesignClick" />
                  <MenuItem x:Name="FileOpenMenuItem" Header="Open Existing Project..." Click="OnOpenProjectClick" />
                  <MenuItem x:Name="FileRecentMenuItem" Header="Recent Projects" Click="OnRecentFilesClick" />
                  <MenuItem x:Name="FileSaveMenuItem" Header="Save" Click="OnSaveProjectClick" />
                  <MenuItem x:Name="FileSaveAsMenuItem" Header="Save As..." Click="OnSaveAsProjectClick" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>

            <Button Content="Create" Classes="ToolbarMenuButton" IsEnabled="{Binding CanPrimitiveTools}">
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Header="Box" Tag="box" Click="OnPrimitiveMenuItemClick" />
                  <MenuItem Header="Cylinder" Tag="cylinder" Click="OnPrimitiveMenuItemClick" />
                  <MenuItem Header="Sphere" Tag="sphere" Click="OnPrimitiveMenuItemClick" />
                  <MenuItem Header="Cone" Tag="cone" Click="OnPrimitiveMenuItemClick" />
                  <MenuItem Header="Torus" Tag="torus" Click="OnPrimitiveMenuItemClick" />
                  <MenuItem Header="Wedge" Tag="wedge" Click="OnPrimitiveMenuItemClick" />
                  <MenuItem Header="Prism" Tag="prism" Click="OnPrimitiveMenuItemClick" />
                  <MenuItem Header="Open Sample / Template" Click="OnOpenSampleTemplateClick" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>

            <Button Content="Sketch" Classes="ToolbarMenuButton">
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem x:Name="SketchStartMenuItem" Header="Start Sketch" Click="OnSketchPrimaryClick" />
                  <MenuItem x:Name="SketchFinishMenuItem" Header="Finish Sketch" Click="OnSketchPrimaryClick" />
                  <MenuItem x:Name="SketchCancelMenuItem" Header="Cancel Sketch" Click="OnSketchCancelClick" />
                  <MenuItem x:Name="SketchLineMenuItem" Header="Line" Tag="Line" Click="OnSketchToolClick" />
                  <MenuItem x:Name="SketchRectangleMenuItem" Header="Rectangle" Tag="Rectangle" Click="OnSketchToolClick" />
                  <MenuItem x:Name="SketchCircleMenuItem" Header="Circle" Tag="Circle" Click="OnSketchToolClick" />
                  <MenuItem x:Name="SketchArcMenuItem" Header="Arc" Tag="Arc" Click="OnSketchToolClick" />
                  <MenuItem x:Name="SketchPointMenuItem" Header="Point" Tag="Point" Click="OnSketchToolClick" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>

            <Button Content="Solid" Classes="ToolbarMenuButton">
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem x:Name="SolidExtrudeMenuItem" Header="Extrude" Click="OnExtrudeClick" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>

            <Button Content="Transform" Classes="ToolbarMenuButton">
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem x:Name="TransformMoveMenuItem" Header="Move Tool" Click="OnMoveToolClick" />
                  <MenuItem x:Name="TransformDatumMenuItem" Header="Create Datum Plane" Click="OnCreateDatumPlaneClick" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>

            <Button Content="View" Classes="ToolbarMenuButton">
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem x:Name="ViewFitMenuItem" Header="Focus / Fit View" Click="OnFocusSelectionClick" />
                  <MenuItem x:Name="ViewCommandPaletteMenuItem" Header="Command Palette" Click="OnCommandPaletteClick" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>

            <Button Content="AI" Classes="ToolbarMenuButton">
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem x:Name="AiOpenMenuItem" Header="Open Copilot" Click="OnOpenAssistantWorkspaceClick" />
                  <MenuItem x:Name="AiConfigureMenuItem" Header="Configure AI..." Click="OnAiSettingsClick" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>

            <Button Content="Recipe" Classes="ToolbarMenuButton">
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem x:Name="RecipeOpenAclMenuItem" Header="Open ACL Panel" Click="OnOpenAclPanelClick" />
                  <MenuItem x:Name="RecipeOpenSampleMenuItem" Header="Open Sample Recipe" Click="OnOpenSampleRecipeClick" />
                  <MenuItem x:Name="RecipeRunMenuItem" Header="Run Active Recipe" Click="OnRunActiveRecipeClick" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>

            <Button Content="Export" Classes="ToolbarMenuButton">
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem x:Name="ExportPrepareMenuItem" Header="Prepare Workspace" Click="OnPrepareWorkspaceMenuClick" />
                  <MenuItem x:Name="ExportDialogMenuItem" Header="Export STL / OBJ..." Click="OnExportClick" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>

            <Button Content="Experimental" Classes="ToolbarMenuButton">
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem x:Name="ExperimentalRevolveMenuItem" Header="Revolve" Click="OnRevolveClick" />
                  <MenuItem x:Name="ExperimentalSweepMenuItem" Header="Sweep" Click="OnSweepClick" />
                  <MenuItem x:Name="ExperimentalLoftMenuItem" Header="Loft" Click="OnLoftClick" />
                  <MenuItem x:Name="ExperimentalQuickExportMenuItem" Header="Quick Export STL" Click="OnQuickExportClick" />
                  <MenuItem x:Name="ExperimentalFilletMenuItem" Header="Fillet" Click="OnFilletClick" />
                  <MenuItem x:Name="ExperimentalChamferMenuItem" Header="Chamfer" Click="OnChamferClick" />
                  <MenuItem x:Name="ExperimentalHoleMenuItem" Header="Hole" Click="OnHoleClick" />
                  <MenuItem x:Name="ExperimentalShellMenuItem" Header="Shell" Click="OnShellClick" />
                  <MenuItem x:Name="ExperimentalLinearPatternMenuItem" Header="Linear Pattern" Click="OnLinearPatternClick" />
                  <MenuItem x:Name="ExperimentalCircularPatternMenuItem" Header="Circular Pattern" Click="OnCircularPatternClick" />
                  <MenuItem x:Name="ExperimentalMirrorMenuItem" Header="Mirror Body" Click="OnMirrorMenuItemClick" />
                  <MenuItem x:Name="ExperimentalBooleanUnionMenuItem" Header="Boolean Union" Click="OnBooleanUnionClick" />
                  <MenuItem x:Name="ExperimentalBooleanSubtractMenuItem" Header="Boolean Subtract" Click="OnBooleanSubtractClick" />
                  <MenuItem x:Name="ExperimentalBooleanIntersectMenuItem" Header="Boolean Intersect" Click="OnBooleanIntersectClick" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>

          </StackPanel>
          <ScrollViewer HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled"
                        IsVisible="True">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="Workflow" Classes="ToolbarGroupLabel" />
            <Border Classes="ToolSplitGroup" Padding="4" IsVisible="{Binding IsThreeDMode}">
              <Button x:Name="ToolbarSketchStartButton"
                      Classes="ToolbarActionButton"
                      IsEnabled="{Binding CanSketchPrimaryAction}"
                      Click="OnSketchPrimaryClick">
                <svg:Svg Path="avares://My3DApp/Assets/Icons/pencil.svg"
                         Width="15"
                         Height="15" />
              </Button>
            </Border>

            <Border Classes="ToolSplitGroup" Padding="4" IsVisible="{Binding IsSketchMode}">
              <StackPanel Orientation="Horizontal" Spacing="3">
                <Button x:Name="ToolbarSketchFinishButton"
                        Classes="ToolbarActionButton"
                        IsEnabled="{Binding CanFinishSketch}"
                        Click="OnSketchPrimaryClick">
                  <svg:Svg Path="avares://My3DApp/Assets/Icons/check.svg"
                           Width="15"
                           Height="15" />
                </Button>
                <Button x:Name="ToolbarSketchCancelButton"
                        Classes="ToolbarActionButton"
                        IsEnabled="{Binding CanCancelSketch}"
                        Click="OnSketchCancelClick">
                  <svg:Svg Path="avares://My3DApp/Assets/Icons/delete.svg"
                           Width="15"
                           Height="15" />
                </Button>
              </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsThreeDMode}">
              <Border Classes="ToolbarDivider" />
              <Border Classes="ToolSplitGroup" Padding="4">
                <StackPanel Orientation="Horizontal" Spacing="3">
                  <Button x:Name="ToolbarNewButton"
                          Classes="ToolbarActionButton"
                          Click="OnNewProjectClick">
                    <svg:Svg Path="avares://My3DApp/Assets/Icons/plus.svg" Width="16" Height="16" />
                  </Button>
                  <Button x:Name="ToolbarOpenButton"
                          Classes="ToolbarActionButton"
                          Click="OnOpenProjectClick">
                    <svg:Svg Path="avares://My3DApp/Assets/Icons/open.svg" Width="16" Height="16" />
                  </Button>
                  <Button x:Name="RecentFilesButton"
                          Classes="ToolbarActionButton"
                          ToolTip.Tip="Recent projects"
                          IsEnabled="{Binding HasRecentFiles}"
                          Click="OnRecentFilesClick">
                    <svg:Svg Path="avares://My3DApp/Assets/Icons/chevron-down.svg" Width="12" Height="12" />
                  </Button>
                  <Button x:Name="ToolbarSaveButton"
                          Classes="ToolbarActionButton"
                          Click="OnSaveProjectClick">
                    <svg:Svg Path="avares://My3DApp/Assets/Icons/save.svg" Width="16" Height="16" />
                  </Button>
                  <Button x:Name="ToolbarSaveAsButton"
                          Classes="ToolbarActionButton"
                          Click="OnSaveAsProjectClick">
                    <TextBlock Text="As"
                               Classes="ToolbarMetaLabel" />
                  </Button>
                </StackPanel>
              </Border>

              <Border Classes="ToolSplitGroup" Padding="4">
                <StackPanel Orientation="Horizontal" Spacing="3">
                  <Button x:Name="ToolbarUndoButton"
                          Classes="ToolbarActionButton"
                          IsEnabled="{Binding CanUndo}"
                          Click="OnUndoClick">
                    <svg:Svg Path="avares://My3DApp/Assets/Icons/undo.svg" Width="16" Height="16" />
                  </Button>
                  <Button x:Name="ToolbarRedoButton"
                          Classes="ToolbarActionButton"
                          IsEnabled="{Binding CanRedo}"
                          Click="OnRedoClick">
                    <svg:Svg Path="avares://My3DApp/Assets/Icons/redo.svg" Width="16" Height="16" />
                  </Button>
                </StackPanel>
              </Border>

              <Button x:Name="ToolbarExportButton"
                      Classes="ToolbarActionButton"
                      Click="OnExportClick">
                <svg:Svg Path="avares://My3DApp/Assets/Icons/export.svg" Width="16" Height="16" />
              </Button>

              <Border Classes="ToolbarDivider" />

              <TextBlock Text="Shapes" Classes="ToolbarGroupLabel" />
              <Border Classes="ToolSplitGroup" Padding="4">
                <StackPanel Orientation="Horizontal" Spacing="3">
                  <ItemsControl ItemsSource="{Binding RecentPrimitiveTools}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="3" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:PrimitiveToolItemViewModel">
                        <Button Classes="ToolbarActionButton"
                                Tag="{Binding Kind}"
                                ToolTip.Tip="{Binding Name}"
                                Click="OnPrimitiveMenuItemClick">
                          <svg:Svg Path="{Binding IconPath}" Width="16" Height="16" />
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Button Classes="ToolbarActionButton PrimitiveMenuButton"
                          IsEnabled="{Binding CanPrimitiveTools}"
                          ToolTip.Tip="More primitives">
                    <Button.Flyout>
                      <MenuFlyout>
                      <MenuItem Tag="box" Click="OnPrimitiveMenuItemClick">
                        <MenuItem.Header>
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <svg:Svg Path="avares://My3DApp/Assets/Icons/box.svg" Width="16" Height="16" />
                            <TextBlock Text="Box" />
                          </StackPanel>
                        </MenuItem.Header>
                      </MenuItem>
                      <MenuItem Tag="cylinder" Click="OnPrimitiveMenuItemClick">
                        <MenuItem.Header>
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <svg:Svg Path="avares://My3DApp/Assets/Icons/cylinder.svg" Width="16" Height="16" />
                            <TextBlock Text="Cylinder" />
                          </StackPanel>
                        </MenuItem.Header>
                      </MenuItem>
                      <MenuItem Tag="sphere" Click="OnPrimitiveMenuItemClick">
                        <MenuItem.Header>
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <svg:Svg Path="avares://My3DApp/Assets/Icons/sphere.svg" Width="16" Height="16" />
                            <TextBlock Text="Sphere" />
                          </StackPanel>
                        </MenuItem.Header>
                      </MenuItem>
                      <MenuItem Tag="cone" Click="OnPrimitiveMenuItemClick">
                        <MenuItem.Header>
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <svg:Svg Path="avares://My3DApp/Assets/Icons/cone.svg" Width="16" Height="16" />
                            <TextBlock Text="Cone" />
                          </StackPanel>
                        </MenuItem.Header>
                      </MenuItem>
                      <MenuItem Tag="torus" Click="OnPrimitiveMenuItemClick">
                        <MenuItem.Header>
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <svg:Svg Path="avares://My3DApp/Assets/Icons/torus.svg" Width="16" Height="16" />
                            <TextBlock Text="Torus" />
                          </StackPanel>
                        </MenuItem.Header>
                      </MenuItem>
                      <MenuItem Tag="pyramid" Click="OnPrimitiveMenuItemClick">
                        <MenuItem.Header>
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <svg:Svg Path="avares://My3DApp/Assets/Icons/pyramid.svg" Width="16" Height="16" />
                            <TextBlock Text="Pyramid" />
                          </StackPanel>
                        </MenuItem.Header>
                      </MenuItem>
                      <MenuItem Tag="wedge" Click="OnPrimitiveMenuItemClick">
                        <MenuItem.Header>
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <svg:Svg Path="avares://My3DApp/Assets/Icons/wedge.svg" Width="16" Height="16" />
                            <TextBlock Text="Wedge" />
                          </StackPanel>
                        </MenuItem.Header>
                      </MenuItem>
                      <MenuItem Tag="prism" Click="OnPrimitiveMenuItemClick">
                        <MenuItem.Header>
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <svg:Svg Path="avares://My3DApp/Assets/Icons/prism.svg" Width="16" Height="16" />
                            <TextBlock Text="Prism" />
                          </StackPanel>
                        </MenuItem.Header>
                      </MenuItem>
                      <MenuItem Tag="capsule" Click="OnPrimitiveMenuItemClick">
                        <MenuItem.Header>
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <svg:Svg Path="avares://My3DApp/Assets/Icons/capsule.svg" Width="16" Height="16" />
                            <TextBlock Text="Capsule" />
                          </StackPanel>
                        </MenuItem.Header>
                      </MenuItem>
                      <MenuItem Tag="hemisphere" Click="OnPrimitiveMenuItemClick">
                        <MenuItem.Header>
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <svg:Svg Path="avares://My3DApp/Assets/Icons/hemisphere.svg" Width="16" Height="16" />
                            <TextBlock Text="Hemisphere" />
                          </StackPanel>
                        </MenuItem.Header>
                      </MenuItem>
                      <MenuItem Tag="ellipsoid" Click="OnPrimitiveMenuItemClick">
                        <MenuItem.Header>
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <svg:Svg Path="avares://My3DApp/Assets/Icons/ellipsoid.svg" Width="16" Height="16" />
                            <TextBlock Text="Ellipsoid" />
                          </StackPanel>
                        </MenuItem.Header>
                      </MenuItem>
                      <MenuItem Tag="arrow" Click="OnPrimitiveMenuItemClick">
                        <MenuItem.Header>
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <svg:Svg Path="avares://My3DApp/Assets/Icons/arrow-primitive.svg" Width="16" Height="16" />
                            <TextBlock Text="Arrow" />
                          </StackPanel>
                        </MenuItem.Header>
                      </MenuItem>
                      <MenuItem Tag="icosphere" Click="OnPrimitiveMenuItemClick">
                        <MenuItem.Header>
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <svg:Svg Path="avares://My3DApp/Assets/Icons/icosphere.svg" Width="16" Height="16" />
                            <TextBlock Text="Icosphere" />
                          </StackPanel>
                        </MenuItem.Header>
                      </MenuItem>
                      <MenuItem Tag="tetrahedron" Click="OnPrimitiveMenuItemClick">
                        <MenuItem.Header>
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <svg:Svg Path="avares://My3DApp/Assets/Icons/tetrahedron.svg" Width="16" Height="16" />
                            <TextBlock Text="Tetrahedron" />
                          </StackPanel>
                        </MenuItem.Header>
                      </MenuItem>
                      <MenuItem Tag="octahedron" Click="OnPrimitiveMenuItemClick">
                        <MenuItem.Header>
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <svg:Svg Path="avares://My3DApp/Assets/Icons/octahedron.svg" Width="16" Height="16" />
                            <TextBlock Text="Octahedron" />
                          </StackPanel>
                        </MenuItem.Header>
                      </MenuItem>
                      <MenuItem Tag="icosahedron" Click="OnPrimitiveMenuItemClick">
                        <MenuItem.Header>
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <svg:Svg Path="avares://My3DApp/Assets/Icons/icosahedron.svg" Width="16" Height="16" />
                            <TextBlock Text="Icosahedron" />
                          </StackPanel>
                        </MenuItem.Header>
                      </MenuItem>
                      </MenuFlyout>
                    </Button.Flyout>
                    <svg:Svg Path="avares://My3DApp/Assets/Icons/chevron-down.svg" Width="10" Height="10" />
                  </Button>
                </StackPanel>
              </Border>

              <Border Classes="ToolbarDivider" />

              <TextBlock Text="Features" Classes="ToolbarGroupLabel" />
              <Border Classes="ToolSplitGroup" Padding="4">
                <StackPanel Orientation="Horizontal" Spacing="3">
                  <Button x:Name="ToolbarExtrudeButton"
                          Classes="ToolbarActionButton"
                          Click="OnExtrudeClick">
                    <svg:Svg Path="avares://My3DApp/Assets/Icons/extrude.svg" Width="16" Height="16" />
                  </Button>
                </StackPanel>
              </Border>

              <Border Classes="ToolbarDivider" />
              <TextBlock Text="View" Classes="ToolbarGroupLabel" />
              <Button x:Name="ToolbarFitViewButton"
                      Classes="ToolbarActionButton"
                      Click="OnFocusSelectionClick">
                <svg:Svg Path="avares://My3DApp/Assets/Icons/focus.svg" Width="16" Height="16" />
              </Button>

              <Border Classes="ToolbarDivider" />
              <TextBlock Text="Transform" Classes="ToolbarGroupLabel" />
              <ToggleButton x:Name="MoveToolButton"
                            Classes="ToolbarIconToggle"
                            Click="OnMoveToolClick">
                <svg:Svg Path="avares://My3DApp/Assets/Icons/move.svg" Width="16" Height="16" />
              </ToggleButton>

              <Border Classes="ToolbarDivider" />
              <TextBlock Text="Workflow" Classes="ToolbarGroupLabel" />
              <Button x:Name="ToolbarTemplatesButton"
                      Classes="ToolbarActionButton"
                      Content="Templates"
                      Click="OnOpenTemplatesWorkspaceClick" />
              <Button x:Name="ToolbarAclButton"
                      Classes="ToolbarActionButton"
                      Content="ACL"
                      Click="OnOpenAclPanelClick" />
              <Button x:Name="ToolbarRecipeButton"
                      Classes="ToolbarActionButton"
                      Content="Recipe"
                      Click="OnOpenSampleRecipeClick" />
              <Button x:Name="ToolbarCopilotButton"
                      Classes="ToolbarActionButton"
                      Content="Copilot"
                      Click="OnOpenAssistantWorkspaceClick" />
              <Button x:Name="ToolbarPrepareButton"
                      Classes="ToolbarActionButton"
                      Content="Prepare"
                      Click="OnPrepareWorkspaceMenuClick" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsSketchMode}">
              <Border Classes="ToolbarDivider" />

              <TextBlock Text="Sketch" Classes="ToolbarGroupLabel" />
              <Border Classes="ToolSplitGroup" Padding="4">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <ToggleButton Classes="ToolbarIconToggle"
                                Tag="Line"
                                ToolTip.Tip="Line (L)"
                                IsChecked="{Binding IsLineSketchToolSelected, Mode=OneWay}"
                                IsEnabled="{Binding CanSketchTools}"
                                Click="OnSketchToolClick">
                    <svg:Svg Path="avares://My3DApp/Assets/Icons/line.svg"
                             Width="16"
                             Height="16" />
                  </ToggleButton>
                  <ToggleButton Classes="ToolbarIconToggle"
                                Tag="Rectangle"
                                ToolTip.Tip="Rectangle (R)"
                                IsChecked="{Binding IsRectangleSketchToolSelected, Mode=OneWay}"
                                IsEnabled="{Binding CanSketchTools}"
                                Click="OnSketchToolClick">
                    <svg:Svg Path="avares://My3DApp/Assets/Icons/rectangle.svg"
                             Width="16"
                             Height="16" />
                  </ToggleButton>
                  <ToggleButton Classes="ToolbarIconToggle"
                                Tag="Circle"
                                ToolTip.Tip="Circle (C)"
                                IsChecked="{Binding IsCircleSketchToolSelected, Mode=OneWay}"
                                IsEnabled="{Binding CanSketchTools}"
                                Click="OnSketchToolClick">
                    <svg:Svg Path="avares://My3DApp/Assets/Icons/circle.svg"
                             Width="16"
                             Height="16" />
                  </ToggleButton>
                  <ToggleButton Classes="ToolbarIconToggle"
                                Tag="Arc"
                                ToolTip.Tip="Arc (A)"
                                IsChecked="{Binding IsArcSketchToolSelected, Mode=OneWay}"
                                IsEnabled="{Binding CanSketchTools}"
                                Click="OnSketchToolClick">
                    <svg:Svg Path="avares://My3DApp/Assets/Icons/arc.svg"
                             Width="16"
                             Height="16" />
                  </ToggleButton>
                  <ToggleButton Classes="ToolbarIconToggle"
                                Tag="Point"
                                ToolTip.Tip="Point (P)"
                                IsChecked="{Binding IsPointSketchToolSelected, Mode=OneWay}"
                                IsEnabled="{Binding CanSketchTools}"
                                Click="OnSketchToolClick">
                    <svg:Svg Path="avares://My3DApp/Assets/Icons/point.svg"
                             Width="16"
                             Height="16" />
                  </ToggleButton>
                  <ToggleButton Classes="ToolbarIconToggle"
                                Tag="Trim"
                                ToolTip.Tip="Trim sketch segment"
                                IsChecked="{Binding IsTrimSketchToolSelected, Mode=OneWay}"
                                IsEnabled="{Binding CanSketchTools}"
                                Click="OnSketchToolClick">
                    <svg:Svg Path="avares://My3DApp/Assets/Icons/trim.svg" Width="16" Height="16" />
                  </ToggleButton>
                  <ToggleButton Classes="ToolbarIconToggle" Tag="Polygon" ToolTip.Tip="Polygon (n-sided)" IsChecked="{Binding IsPolygonSketchToolSelected, Mode=OneWay}" IsEnabled="{Binding CanSketchTools}" Click="OnSketchToolClick">
                    <svg:Svg Path="avares://My3DApp/Assets/Icons/polygon.svg" Width="16" Height="16" />
                  </ToggleButton>
                  <ToggleButton Classes="ToolbarIconToggle" Tag="Slot" ToolTip.Tip="Slot (straight)" IsChecked="{Binding IsSlotSketchToolSelected, Mode=OneWay}" IsEnabled="{Binding CanSketchTools}" Click="OnSketchToolClick">
                    <svg:Svg Path="avares://My3DApp/Assets/Icons/slot.svg" Width="16" Height="16" />
                  </ToggleButton>
                  <ToggleButton Classes="ToolbarIconToggle" Tag="Spline" ToolTip.Tip="Spline (control-point)" IsChecked="{Binding IsSplineSketchToolSelected, Mode=OneWay}" IsEnabled="{Binding CanSketchTools}" Click="OnSketchToolClick">
                    <svg:Svg Path="avares://My3DApp/Assets/Icons/spline.svg" Width="16" Height="16" />
                  </ToggleButton>
                  <ToggleButton Classes="ToolbarIconToggle" Tag="Mirror" ToolTip.Tip="Mirror sketch entities" IsChecked="{Binding IsMirrorSketchToolSelected, Mode=OneWay}" IsEnabled="{Binding CanSketchTools}" Click="OnSketchToolClick">
                    <svg:Svg Path="avares://My3DApp/Assets/Icons/mirror.svg" Width="16" Height="16" />
                  </ToggleButton>
                  <ToggleButton Classes="ToolbarIconToggle" Tag="Offset" ToolTip.Tip="Offset curves" IsChecked="{Binding IsOffsetSketchToolSelected, Mode=OneWay}" IsEnabled="{Binding CanSketchTools}" Click="OnSketchToolClick">
                    <svg:Svg Path="avares://My3DApp/Assets/Icons/offset.svg" Width="16" Height="16" />
                  </ToggleButton>
                  <ToggleButton Classes="ToolbarIconToggle" Tag="Fillet2d" ToolTip.Tip="2D Fillet" IsChecked="{Binding IsFillet2dSketchToolSelected, Mode=OneWay}" IsEnabled="{Binding CanSketchTools}" Click="OnSketchToolClick">
                    <svg:Svg Path="avares://My3DApp/Assets/Icons/fillet2d.svg" Width="16" Height="16" />
                  </ToggleButton>
                </StackPanel>
              </Border>

              <Border Classes="ToolbarDivider" />
              <TextBlock Text="Transform" Classes="ToolbarGroupLabel" />
              <ToggleButton x:Name="SketchTransformToolButton"
                            Classes="ToolbarIconToggle"
                            ToolTip.Tip="Transform sketch entities (move)"
                            IsChecked="{Binding IsTransformSketchToolSelected, Mode=OneWay}"
                            IsEnabled="{Binding CanSketchTools}"
                            Click="OnSketchTransformToolClick">
                <svg:Svg Path="avares://My3DApp/Assets/Icons/move.svg" Width="16" Height="16" />
              </ToggleButton>
              <!-- Rotate tool button — task 52 -->
              <ToggleButton x:Name="SketchRotateToolButton"
                            Classes="ToolbarIconToggle"
                            ToolTip.Tip="Rotate sketch entity about a pivot point"
                            IsEnabled="{Binding CanSketchTools}"
                            Click="OnSketchRotateToolClick">
                <svg:Svg Path="avares://My3DApp/Assets/Icons/rotate.svg" Width="16" Height="16" />
              </ToggleButton>

              <Border Classes="ToolbarDivider" />
              <TextBlock Text="Construction" Classes="ToolbarGroupLabel" />
              <ToggleButton x:Name="ConstructionModeButton"
                            Classes="ToolbarIconToggle"
                            ToolTip.Tip="Toggle construction mode — new entities drawn as construction (dashed)"
                            IsChecked="{Binding IsConstructionModeActive, Mode=OneWay}"
                            IsEnabled="{Binding CanSketchTools}"
                            Click="OnToggleConstructionModeClick">
                <svg:Svg Path="avares://My3DApp/Assets/Icons/construction.svg" Width="16" Height="16" />
              </ToggleButton>

              <Border Classes="ToolbarDivider" />
              <TextBlock Text="Grid" Classes="ToolbarGroupLabel" />
              <ToggleButton x:Name="GridToggleButton"
                            Classes="ToolbarIconToggle"
                            ToolTip.Tip="Toggle grid overlay [G]"
                            IsEnabled="{Binding IsSketchMode}"
                            IsChecked="False"
                            Click="OnGridToggleClick">
                <svg:Svg Path="avares://My3DApp/Assets/Icons/sketch-grid.svg" Width="16" Height="16" />
              </ToggleButton>

              <Border Classes="ToolbarDivider" />
              <TextBlock Text="Dimension" Classes="ToolbarGroupLabel" />
              <ToggleButton Classes="ToolbarIconToggle"
                            Tag="LinearDimension"
                            ToolTip.Tip="Linear Dimension [D] — click a line to add its length"
                            IsChecked="{Binding IsLinearDimensionToolSelected, Mode=OneWay}"
                            IsEnabled="{Binding CanSketchTools}"
                            Click="OnSketchToolClick">
                <svg:Svg Path="avares://My3DApp/Assets/Icons/linear-dimension.svg" Width="16" Height="16" />
              </ToggleButton>
              <ToggleButton Classes="ToolbarIconToggle"
                            Tag="RadiusDimension"
                            ToolTip.Tip="Radius Dimension [I] — click a circle or arc"
                            IsChecked="{Binding IsRadiusDimensionToolSelected, Mode=OneWay}"
                            IsEnabled="{Binding CanSketchTools}"
                            Click="OnSketchToolClick">
                <svg:Svg Path="avares://My3DApp/Assets/Icons/radius-dimension.svg" Width="16" Height="16" />
              </ToggleButton>
              <ToggleButton Classes="ToolbarIconToggle"
                            Tag="AngleDimension"
                            ToolTip.Tip="Angle Dimension — click two lines to measure angle"
                            IsChecked="{Binding IsAngleDimensionToolSelected, Mode=OneWay}"
                            IsEnabled="{Binding CanSketchTools}"
                            Click="OnSketchToolClick">
                <svg:Svg Path="avares://My3DApp/Assets/Icons/angle-dimension.svg" Width="16" Height="16" />
              </ToggleButton>

              <Border Classes="ToolbarDivider" />
              <TextBlock Text="Constraints" Classes="ToolbarGroupLabel" />
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Classes="SketchConstraintToolButton"
                        ToolTip.Tip="Horizontal (snap last line horizontal)"
                        IsEnabled="{Binding CanSketchTools}"
                        Click="OnApplyHorizontalConstraintClick">
                  <svg:Svg Path="avares://My3DApp/Assets/Icons/horizontal.svg" Width="15" Height="15" />
                </Button>
                <Button Classes="SketchConstraintToolButton"
                        ToolTip.Tip="Vertical (snap last line vertical)"
                        IsEnabled="{Binding CanSketchTools}"
                        Click="OnApplyVerticalConstraintClick">
                  <svg:Svg Path="avares://My3DApp/Assets/Icons/vertical.svg" Width="15" Height="15" />
                </Button>
                <Button Classes="SketchConstraintToolButton"
                        ToolTip.Tip="Coincident (snap last line to previous line)"
                        IsEnabled="{Binding CanSketchTools}"
                        Click="OnApplyCoincidentConstraintClick">
                  <svg:Svg Path="avares://My3DApp/Assets/Icons/coincident.svg" Width="15" Height="15" />
                </Button>
                <Button Classes="SketchConstraintToolButton"
                        ToolTip.Tip="Equal (match last two line lengths or radii)"
                        IsEnabled="{Binding CanSketchTools}"
                        Click="OnApplyEqualConstraintClick">
                  <svg:Svg Path="avares://My3DApp/Assets/Icons/equal.svg" Width="15" Height="15" />
                </Button>
                <Button Classes="SketchConstraintToolButton"
                        ToolTip.Tip="Fix (lock last sketch entity)"
                        IsEnabled="{Binding CanSketchTools}"
                        Click="OnApplyFixedConstraintClick">
                  <svg:Svg Path="avares://My3DApp/Assets/Icons/fix.svg" Width="15" Height="15" />
                </Button>
                <Button Classes="SketchConstraintToolButton"
                        ToolTip.Tip="Tangent"
                        IsEnabled="{Binding CanSketchTools}"
                        Click="OnApplyTangentConstraintClick">
                  <svg:Svg Path="avares://My3DApp/Assets/Icons/tangent.svg" Width="15" Height="15" />
                </Button>
                <Button Classes="SketchConstraintToolButton"
                        ToolTip.Tip="Parallel"
                        IsEnabled="{Binding CanSketchTools}"
                        Click="OnApplyParallelConstraintClick">
                  <svg:Svg Path="avares://My3DApp/Assets/Icons/parallel.svg" Width="15" Height="15" />
                </Button>
                <Button Classes="SketchConstraintToolButton"
                        ToolTip.Tip="Perpendicular (make last two lines 90°)"
                        IsEnabled="{Binding CanSketchTools}"
                        Click="OnApplyPerpendicularConstraintClick">
                  <svg:Svg Path="avares://My3DApp/Assets/Icons/perpendicular.svg" Width="15" Height="15" />
                </Button>
                <Button Classes="SketchConstraintToolButton"
                        ToolTip.Tip="Concentric (share center for last two circles/arcs)"
                        IsEnabled="{Binding CanSketchTools}"
                        Click="OnApplyConcentricConstraintClick">
                  <svg:Svg Path="avares://My3DApp/Assets/Icons/concentric.svg" Width="15" Height="15" />
                </Button>
              </StackPanel>

              <Border Classes="ToolbarDivider" />
              <Border Classes="SketchHintPanel" Padding="10,6">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding SketchWorkflowHint}"
                             Classes="ToolbarSubtleText"
                             TextWrapping="Wrap" />
                  <TextBlock Text="{Binding SketchConstraintHint}"
                             Classes="ToolbarMetaLabel" />
                  <TextBlock Text="{Binding SketchCursorPosition}"
                             Classes="ToolbarMetaLabel"
                             FontFamily="Consolas, Courier New, monospace"
                             IsVisible="{Binding IsSketchMode}" />
                  <TextBlock Text="{Binding SketchDofLabel}"
                             Classes="SketchDofStatus"
                             Classes.DofFullyConstrained="{Binding IsDofFullyConstrained}"
                             Classes.DofOverconstrained="{Binding IsDofOverconstrained}"
                             IsVisible="{Binding IsSketchMode}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>
          </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom"
            Classes="PartStudioTabBar"
            Background="{DynamicResource Studio.PanelInsetBrush}"
            BorderBrush="{DynamicResource Studio.BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="10,4">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <ItemsControl ItemsSource="{Binding WorkspaceTabs}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:StudioWorkspaceTabItem">
                  <Button Content="{Binding Title}"
                          Tag="{Binding Kind}"
                          Classes="PartStudioTab"
                          Classes.active="{Binding IsActive}"
                          Click="OnWorkspaceTabClick"
                          ToolTip.Tip="{Binding Title}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Width="1" Height="18" Background="{DynamicResource Studio.BorderBrush}" Opacity="0.5" Margin="4,0" />
            <ItemsControl ItemsSource="{Binding PartStudios}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:PartStudioTabItem">
                  <Grid ColumnDefinitions="Auto,Auto">
                    <Button Content="{Binding Name}"
                            Tag="{Binding Name}"
                            Classes="PartStudioTab"
                            Classes.active="{Binding IsActive}"
                            Click="OnPartStudioTabClick"
                            DoubleTapped="OnPartStudioTabRename"
                            ToolTip.Tip="Click to switch • Double-click to rename" />
                    <Button Grid.Column="1"
                            Content="✕"
                            Tag="{Binding Name}"
                            Classes="PartStudioTabClose"
                            IsVisible="{Binding IsActive}"
                            Click="OnPartStudioTabClose"
                            ToolTip.Tip="Delete this part studio" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="＋"
                    Margin="6,0,0,0"
                    Classes="PartStudioTabAdd"
                    Click="OnAddPartStudioClick"
                    ToolTip.Tip="Add a new part studio" />
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="10,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Ctrl+Z Undo"
                     Classes="ToolbarMetaLabel"
                     IsVisible="{Binding CanUndo}" />
          <TextBlock Text="Ctrl+Y Redo"
                     Classes="ToolbarMetaLabel"
                     IsVisible="{Binding CanRedo}" />
        </StackPanel>
        <TextBlock Grid.Column="2"
                   Text="{Binding StatusBarText}"
                   Classes="ToolbarSubtleText"
                   VerticalAlignment="Center"
                   Margin="10,0,0,0"
                   MaxWidth="360"
                   TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom"
            IsVisible="{Binding HasNotification}"
            Background="{Binding NotificationBackground}"
            Height="32">
      <Grid ColumnDefinitions="*,Auto" Margin="14,0">
        <TextBlock Text="{Binding NotificationText}"
                   Foreground="{Binding NotificationForeground}"
                   FontSize="12"
                   FontWeight="Medium"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="1"
                Content="✕"
                Foreground="{Binding NotificationForeground}"
                Background="Transparent"
                BorderThickness="0"
                Padding="8,0"
                Height="32"
                VerticalAlignment="Center"
                Click="OnDismissNotificationClick" />
      </Grid>
    </Border>

    <Grid ColumnDefinitions="320,8,*,8,320" Margin="10,10,10,8">
      <Border Grid.Column="0"
              Classes="StudioPanelSurface"
              Background="{DynamicResource Studio.PanelBackgroundBrush}"
              BorderBrush="{DynamicResource Studio.BorderBrush}"
              BorderThickness="1">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="12">
          <Border Classes="NavigatorSectionSwitcher"
                  HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal"
                        Spacing="4">
            <ToggleButton Content="Tree"
                          Classes="NavigatorSectionTab"
                          IsChecked="{Binding IsProjectPaneSelected}"
                          Click="OnProjectPaneClick" />
            <ToggleButton Content="Templates"
                          Classes="NavigatorSectionTab"
                          IsChecked="{Binding IsTemplatesPaneSelected}"
                          Click="OnTemplatesPaneClick" />
            <ToggleButton Content="Library"
                          Classes="NavigatorSectionTab"
                          IsChecked="{Binding IsLibraryPaneSelected}"
                          Click="OnLibraryPaneClick" />
            </StackPanel>
          </Border>
          <Grid Grid.Row="1"
                ColumnDefinitions="34,*"
                VerticalAlignment="Center"
                IsVisible="{Binding IsProjectPaneVisible}">
            <Border Classes="TreeFilterIconShell">
              <svg:Svg Path="avares://My3DApp/Assets/Icons/filter.svg"
                       Width="16"
                       Height="16"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            </Border>
            <TextBox Grid.Column="1"
                     Margin="8,0,0,0"
                     Watermark="Filter by name or type"
                     Text="{Binding FeatureTreeFilterText, Mode=TwoWay}"
                     Classes="TreeFilterTextBox" />
          </Grid>
            <Grid Grid.Row="2"
                  RowDefinitions="Auto,Auto"
                  Margin="0,12,0,0">
              <TextBlock Text="{Binding LeftPaneTitle}"
                          Classes="FeatureListHeaderText" />
              <TextBlock Grid.Row="1"
                         Margin="0,3,0,0"
                         Text="{Binding LeftPaneSummary}"
                         TextWrapping="Wrap"
                         Classes="FeatureListMetaText" />
            </Grid>
          <StackPanel Grid.Row="3"
                      Margin="0,10,0,0"
                      Spacing="0"
                      IsVisible="{Binding IsSketchMode}">
            <Border Classes="SketchTaskCard">
              <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                <TextBlock Text="{Binding ActiveSketchTaskTitle}"
                           Classes="SketchTaskTitle" />
                <Button Grid.Column="1"
                        Width="28"
                        Height="28"
                        Margin="8,0,0,0"
                        Classes="SketchTaskActionButton"
                        IsEnabled="{Binding CanFinishSketch}"
                        ToolTip.Tip="Finish Sketch"
                        Click="OnSketchFinishClick">
                  <svg:Svg Path="avares://My3DApp/Assets/Icons/check.svg"
                           Width="14"
                           Height="14" />
                </Button>
                <Button Grid.Column="2"
                        Width="28"
                        Height="28"
                        Margin="6,0,0,0"
                        Classes="SketchTaskActionButton"
                        IsEnabled="{Binding CanCancelSketch}"
                        ToolTip.Tip="Cancel Sketch"
                        Click="OnSketchCancelClick">
                  <TextBlock Text="✕"
                             FontSize="12"
                             FontWeight="SemiBold" />
                </Button>
                <TextBlock Grid.Row="1"
                           Grid.ColumnSpan="3"
                           Margin="0,8,0,0"
                           Text="{Binding ActiveSketchTaskSummary}"
                           Classes="SketchTaskSummary" />
                <Border Grid.Row="2"
                        Grid.ColumnSpan="3"
                        Margin="0,8,0,0"
                        Classes="SketchTaskStatusChip"
                        Classes.DofFullyConstrained="{Binding IsDofFullyConstrained}"
                        Classes.DofOverconstrained="{Binding IsDofOverconstrained}"
                        Classes.DofUnderconstrained="{Binding IsDofUnderconstrained}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding SketchDofLabel}"
                               Classes="SketchTaskStatusText" />
                    <TextBlock Text="{Binding SketchDefinitionDetail}"
                               Classes="SketchTaskStatusHelp"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <TextBlock Grid.Row="3"
                           Grid.ColumnSpan="3"
                           Margin="0,6,0,0"
                           Text="{Binding ActiveSketchTaskDetails}"
                           TextWrapping="Wrap"
                           Classes="SketchTaskDetails" />
              </Grid>
            </Border>

            <!-- Constraints panel -->
            <Border Classes="SketchSidePanel"
                    IsVisible="{Binding HasActiveSketchConstraints}">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding ActiveSketchConstraintCountLabel}"
                           Classes="SketchSidePanelHeader" />
                <ItemsControl ItemsSource="{Binding ActiveSketchConstraints}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="20,*,Auto" Margin="0,1,0,1">
                        <TextBlock Text="{Binding Icon}"
                                   Classes="SketchConstraintIcon"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Description}"
                                   Classes="SketchConstraintLabel"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="2"
                                Width="20" Height="20"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTip.Tip="Remove constraint"
                                Tag="{Binding Index}"
                                Click="OnDeleteSketchConstraintClick">
                          <TextBlock Text="✕" FontSize="9" FontWeight="SemiBold"
                                     Foreground="{DynamicResource Studio.TextMutedBrush}" />
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- Dimensions panel -->
            <Border Classes="SketchSidePanel"
                    IsVisible="{Binding HasActiveSketchDimensions}">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding ActiveSketchDimensionCountLabel}"
                           Classes="SketchSidePanelHeader" />
                <ItemsControl ItemsSource="{Binding ActiveSketchDimensions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="28,*,Auto" Margin="0,2,0,2">
                        <TextBlock Text="{Binding Label}"
                                   Classes="SketchDimensionLabel"
                                   VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="1"
                                       Value="{Binding Value, Mode=OneWay}"
                                       IsEnabled="{Binding IsEditable}"
                                       Minimum="0.01"
                                       Maximum="9999"
                                       Increment="1"
                                       FormatString="0.###"
                                       Height="26"
                                       FontSize="11"
                                       Tag="{Binding}"
                                       ValueChanged="OnSketchDimensionValueChanged" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Unit}"
                                   Classes="SketchDimensionUnit" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
          <TreeView x:Name="FeatureTreeView"
                    Grid.Row="4"
                    Margin="0,8,0,0"
                    ItemsSource="{Binding FeatureNodes}"
                    IsVisible="{Binding IsProjectPaneVisible}"
                    Classes="FeatureTree"
                    Background="Transparent"
                    SelectionChanged="OnFeatureTreeSelectionChanged"
                    DoubleTapped="OnFeatureTreeDoubleTapped"
                    KeyDown="OnFeatureTreeKeyDown">
            <TreeView.ItemTemplate>
              <TreeDataTemplate DataType="vm:FeatureNodeViewModel" ItemsSource="{Binding Children}">
                <Grid ColumnDefinitions="20,*" RowDefinitions="Auto,Auto" Margin="0,1,0,1"
                      Opacity="{Binding BodyOpacity}"
                      ToolTip.Tip="{Binding TooltipText}">
                  <Grid.ContextMenu>
                    <ContextMenu IsVisible="{Binding IsSelectable}">
                      <MenuItem Header="Start Sketch"
                                IsVisible="{Binding CanStartSketchOnPlane}"
                                Tag="start-sketch"
                                Click="OnFeatureTreeContextMenuClick" />
                      <MenuItem Header="Edit Sketch"
                                IsVisible="{Binding CanEditSketch}"
                                Tag="edit-sketch"
                                Click="OnFeatureTreeContextMenuClick" />
                      <MenuItem Header="Edit Parameters"
                                IsVisible="{Binding CanEditParameters}"
                                Tag="edit-parameters"
                                Click="OnFeatureTreeContextMenuClick" />
                      <MenuItem Header="Rename…"
                                IsVisible="{Binding CanRenameItem}"
                                Tag="rename"
                                Click="OnFeatureTreeContextMenuClick" />
                      <MenuItem Header="Duplicate"
                                IsVisible="{Binding CanDuplicateItem}"
                                Tag="duplicate"
                                Click="OnFeatureTreeContextMenuClick" />
                      <MenuItem Header="Toggle Visibility"
                                IsVisible="{Binding CanToggleBodyVisibility}"
                                Tag="toggle-visibility"
                                Click="OnFeatureTreeContextMenuClick" />
                      <MenuItem Header="Set Color…"
                                IsVisible="{Binding CanSetColor}"
                                Tag="set-color"
                                Click="OnFeatureTreeContextMenuClick" />
                      <MenuItem Header="Delete Entity"
                                IsVisible="{Binding CanDeleteSketchEntity}"
                                Tag="delete"
                                Click="OnFeatureTreeContextMenuClick" />
                      <MenuItem Header="Delete"
                                IsVisible="{Binding CanDeleteModelItem}"
                                Tag="delete"
                                Click="OnFeatureTreeContextMenuClick" />
                    </ContextMenu>
                  </Grid.ContextMenu>
                  <svg:Svg Grid.RowSpan="2"
                           Width="15"
                           Height="15"
                           Margin="0,2,8,0"
                           Path="{Binding IconPath}"
                           IsVisible="{Binding HasSvgIcon}" />
                  <Border Classes="TreeNodeGlyph"
                          Grid.RowSpan="2"
                          IsVisible="{Binding ShowGlyph}"
                          Margin="0,1,8,0">
                    <TextBlock Text="{Binding IconToken}"
                               Classes="TreeNodeGlyphText" />
                  </Border>
                  <TextBlock Grid.Column="1"
                             Text="{Binding Name}"
                             VerticalAlignment="Center"
                             IsVisible="{Binding ShowItemName}"
                             Classes="TreeNodeNameText"
                             Classes.SketchUnderdefined="{Binding IsSketchUnderdefined}"
                             Classes.SketchFullyDefined="{Binding IsSketchFullyDefined}"
                             Classes.SketchOverdefined="{Binding IsSketchOverdefined}" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding Name}"
                             VerticalAlignment="Center"
                             IsVisible="{Binding ShowSectionName}"
                             Classes="TreeSectionNameText" />
                  <TextBlock Grid.Row="1"
                             Grid.Column="1"
                             Margin="0,2,0,0"
                             Text="{Binding SecondaryText}"
                             TextWrapping="Wrap"
                             IsVisible="{Binding ShowSecondaryText}"
                             Classes="TreeNodeSecondaryText"
                             Classes.SketchUnderdefined="{Binding IsSketchUnderdefined}"
                             Classes.SketchFullyDefined="{Binding IsSketchFullyDefined}"
                             Classes.SketchOverdefined="{Binding IsSketchOverdefined}" />
                </Grid>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
          <Border Grid.Row="4"
                  Margin="0,8,0,0"
                  Classes="SketchSidePanel"
                  IsVisible="{Binding IsTemplatesPaneVisible}">
            <StackPanel Spacing="8">
              <Border Classes="AssistantContextCard">
                <StackPanel Spacing="8">
                  <TextBlock Text="Active template workbench"
                             Classes="AssistantContextPrimary" />
                  <TextBlock Text="{Binding SelectedMakerTemplateName}"
                             Foreground="{DynamicResource Studio.TextPrimaryBrush}" />
                  <TextBlock Text="{Binding SelectedTemplateWorkflowHint}"
                             TextWrapping="Wrap"
                             Classes="AssistantContextSecondary" />
                  <TextBlock Text="{Binding SelectedTemplateValidationSummary}"
                             TextWrapping="Wrap"
                             Classes="ToolbarSubtleText" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Generate"
                            Classes="AssistantApplyButton"
                            IsEnabled="{Binding CanApplySelectedTemplate}"
                            Click="OnApplyTemplateClick" />
                    <Button Content="Generate + Prepare"
                            Classes="AssistantSecondaryButton"
                            IsEnabled="{Binding CanApplySelectedTemplate}"
                            Click="OnApplyTemplateAndPrepareClick" />
                    <Button Content="Ask Copilot"
                            Classes="AssistantSecondaryButton"
                            Click="OnTemplateCopilotClick" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <TextBlock Text="Starter templates"
                         Classes="SketchSidePanelHeader" />
              <TextBlock Text="Maker-friendly parametric starting points. Pick one, edit the parameters, then generate the part into the active part studio."
                         TextWrapping="Wrap"
                         Classes="SketchTaskDetails" />
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding TemplateCatalog}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="services:MakerTemplateDefinition">
                      <Border Classes="AssistantContextCard" Margin="0,0,0,6">
                        <StackPanel Spacing="6">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                              <TextBlock Text="{Binding DisplayName}"
                                         Classes="AssistantContextPrimary" />
                              <TextBlock Text="{Binding Category}"
                                         Classes="ToolbarMetaLabel" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Tag="{Binding Id}"
                                    Classes="AssistantSecondaryButton"
                                    Click="OnTemplateCatalogClick"
                                    Content="Select" />
                          </Grid>
                          <TextBlock Text="{Binding Description}"
                                     TextWrapping="Wrap"
                                     Classes="AssistantContextSecondary" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>
          <Border Grid.Row="4"
                  Margin="0,8,0,0"
                  Classes="SketchSidePanel"
                  IsVisible="{Binding IsLibraryPaneVisible}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="10">
                <Border Classes="AssistantContextCard"
                        IsVisible="{Binding HasRecoveryAvailable}">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Recovery center"
                               Classes="AssistantContextPrimary" />
                    <TextBlock Text="{Binding StartupRecoverySummary}"
                               TextWrapping="Wrap"
                               Classes="AssistantContextSecondary" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="Restore autosave"
                              Classes="AssistantApplyButton"
                              Click="OnRestoreAutosaveClick" />
                      <Button Content="Discard"
                              Classes="AssistantSecondaryButton"
                              Click="OnDiscardAutosaveClick" />
                    </StackPanel>
                  </StackPanel>
                </Border>
                <Border Classes="AssistantContextCard">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Recent projects"
                               Classes="AssistantContextPrimary" />
                    <TextBlock Text="Jump back into a saved local project without leaving the studio."
                               TextWrapping="Wrap"
                               Classes="AssistantContextSecondary" />
                    <ItemsControl ItemsSource="{Binding RecentDocumentItems}"
                                  IsVisible="{Binding HasRecentDocumentItems}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:RecentDocumentItemViewModel">
                          <Button Tag="{Binding FullPath}"
                                  Margin="0,0,0,6"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Left"
                                  Classes="AssistantSecondaryButton"
                                  ToolTip.Tip="{Binding FullPath}"
                                  Click="OnRecentDocumentLibraryClick">
                            <StackPanel Spacing="1">
                              <TextBlock Text="{Binding DisplayName}" />
                              <TextBlock Text="{Binding Summary}"
                                         Classes="ToolbarMetaLabel" />
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No recent projects yet. Create or save a project to pin it here."
                               TextWrapping="Wrap"
                               Classes="AssistantContextSecondary"
                               IsVisible="{Binding HasNoRecentDocumentItems}" />
                  </StackPanel>
                </Border>
                <Border Classes="AssistantContextCard">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Template library"
                               Classes="AssistantContextPrimary" />
                    <TextBlock Text="Open a starter template directly into the Templates workspace and keep building from there."
                               TextWrapping="Wrap"
                               Classes="AssistantContextSecondary" />
                    <ItemsControl ItemsSource="{Binding TemplateCatalog}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="services:MakerTemplateDefinition">
                          <Button Tag="{Binding Id}"
                                  Margin="0,0,0,6"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Left"
                                  Classes="AssistantSecondaryButton"
                                  ToolTip.Tip="{Binding Description}"
                                  Click="OnLibraryTemplateOpenClick">
                            <StackPanel Spacing="1">
                              <TextBlock Text="{Binding DisplayName}" />
                              <TextBlock Text="{Binding Category}"
                                         Classes="ToolbarMetaLabel" />
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
                <Border Classes="AssistantContextCard">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Studio launch"
                               Classes="AssistantContextPrimary" />
                    <CheckBox Content="Show home screen on launch"
                              IsChecked="{Binding ShowStartupPageOnLaunch, Mode=TwoWay}"
                              Classes="FeatureDialogCheckBox" />
                    <TextBlock Text="{Binding StartupLaunchPreferenceSummary}"
                               TextWrapping="Wrap"
                               Classes="AssistantContextSecondary" />
                  </StackPanel>
                </Border>
                <Border Classes="AssistantContextCard"
                        IsVisible="{Binding HasExportJobs}">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Recent exports"
                               Classes="AssistantContextPrimary" />
                    <TextBlock Text="{Binding LastExportSummary}"
                               TextWrapping="Wrap"
                               Classes="AssistantContextSecondary" />
                    <Button Content="Open Prepare workspace"
                            Classes="AssistantSecondaryButton"
                            Click="OnPrepareWorkspaceMenuClick" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1"
                    Classes="StudioSplitter" />

      <Grid Grid.Column="2" RowDefinitions="*" Margin="8,0,8,0">
        <Border Grid.Row="0"
                Classes="StudioPanelSurface StudioViewportSurface"
                Background="{DynamicResource Studio.ViewportBackgroundBrush}"
                BorderBrush="{DynamicResource Studio.BorderBrush}"
                BorderThickness="1">
          <Grid RowDefinitions="Auto,*">
            <Border Background="{DynamicResource Studio.PanelInsetBrush}"
                    BorderBrush="{DynamicResource Studio.BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,7">
              <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel Spacing="2">
                  <TextBlock FontWeight="SemiBold"
                             Foreground="{DynamicResource Studio.TextPrimaryBrush}"
                             Classes="ViewportHeaderTitle"
                             Text="{Binding WorkspaceSurfaceTitle}" />
                  <TextBlock Text="{Binding WorkspaceSurfaceSummary}"
                             Classes="ViewportHeaderSecondary" />
                </StackPanel>
                <Border Grid.Column="1" Classes="ViewportInfoTag" Margin="8,0,0,0">
                  <TextBlock Text="{Binding WorkspaceModeBadge}" Classes="ViewportInfoTagText" />
                </Border>
                <Border Grid.Column="2" Classes="ViewportInfoTag" Margin="8,0,0,0">
                  <TextBlock Text="{Binding AssistantPlaneSummary}" Classes="ViewportInfoTagText" />
                </Border>
              </Grid>
            </Border>
            <controls:WebViewportHost x:Name="ViewportHost" Grid.Row="1" IsVisible="{Binding IsCadWorkspaceVisible}" />
            <Grid Grid.Row="1"
                  Margin="14"
                  RowDefinitions="Auto,Auto,*">
              <Border Classes="ViewportSketchPrompt"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      IsHitTestVisible="False"
                      IsVisible="{Binding IsThreeDMode}">
                <TextBlock Text="{Binding SketchWorkflowHint}"
                           Classes="ViewportPromptText"
                           TextWrapping="Wrap"
                           MaxWidth="280" />
              </Border>

              <Border Grid.RowSpan="2"
                      Classes="ViewportPlanePickCard"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      IsVisible="{Binding IsSelectingSketchPlane}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Classes="ViewportPlanePickBadge"
                          VerticalAlignment="Center">
                    <TextBlock Text="SKETCH"
                               Classes="ViewportPlanePickBadgeText" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2" Margin="10,0,10,0">
                    <TextBlock Text="{Binding ViewportSketchEntryLabel}"
                               Classes="ViewportSessionTitle" />
                    <TextBlock Text="{Binding ViewportSketchSessionSummary}"
                               Classes="ViewportSessionSummary"
                               TextWrapping="Wrap"
                               MaxWidth="360" />
                  </StackPanel>
                  <Button Grid.Column="2"
                          Classes="FeatureDialogButtonSecondary"
                          VerticalAlignment="Center"
                          ToolTip.Tip="Cancel sketch plane selection"
                          Click="OnSketchCancelClick"
                          Content="Cancel" />
                </Grid>
              </Border>

              <Border Grid.Row="1"
                      Classes="ViewportSketchSessionCard"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Margin="0,8,0,0"
                      IsHitTestVisible="False"
                      IsVisible="{Binding IsSketchMode}">
                <StackPanel Spacing="3">
                  <TextBlock Text="{Binding ViewportSketchSessionTitle}"
                             Classes="ViewportSessionTitle" />
                  <TextBlock Text="{Binding ViewportSketchSessionSummary}"
                             Classes="ViewportSessionSummary"
                             TextWrapping="Wrap"
                             MaxWidth="280" />
                  <TextBlock Text="{Binding SketchDofLabel}"
                             Foreground="{Binding SketchDofBrush}"
                             FontSize="11"
                             Margin="0,2,0,0" />
                </StackPanel>
              </Border>

              <Border Grid.RowSpan="3"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      MaxWidth="520"
                      Classes="ViewportSketchSessionCard"
                      IsVisible="{Binding IsTemplateOverlayVisible}">
                <StackPanel Spacing="10" Width="480">
                  <TextBlock Text="{Binding SelectedMakerTemplateName}"
                             Classes="ViewportSessionTitle" />
                  <TextBlock Text="{Binding SelectedMakerTemplateDescription}"
                             TextWrapping="Wrap"
                             Classes="ViewportSessionSummary" />
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding SelectedMakerTemplateCategory}"
                               Classes="ToolbarMetaLabel" />
                    <TextBlock Text="{Binding SelectedMakerTemplateTags}"
                               TextWrapping="Wrap"
                               Classes="ToolbarSubtleText" />
                  </StackPanel>
                  <Border Classes="AssistantContextCard"
                          IsVisible="{Binding HasSelectedMakerTemplatePresets}">
                    <StackPanel Spacing="8">
                      <TextBlock Text="Quick presets"
                                 Classes="AssistantContextPrimary" />
                      <ItemsControl ItemsSource="{Binding SelectedMakerTemplatePresets}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="services:MakerTemplatePreset">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,2">
                              <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Name}"
                                           Foreground="{DynamicResource Studio.TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Description}"
                                           TextWrapping="Wrap"
                                           Classes="ToolbarSubtleText" />
                              </StackPanel>
                              <Button Grid.Column="1"
                                      Margin="12,0,0,0"
                                      Content="Apply"
                                      Tag="{Binding Name}"
                                      Classes="AssistantSecondaryButton"
                                      Click="OnApplyTemplatePresetClick" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                  <Border Classes="AssistantContextCard">
                    <TextBlock Text="{Binding SelectedTemplateValidationSummary}"
                               TextWrapping="Wrap"
                               Classes="AssistantContextSecondary" />
                  </Border>
                  <ItemsControl ItemsSource="{Binding TemplateParameters}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:ParameterItemViewModel">
                        <Border Classes="AssistantContextCard" Padding="10" Margin="0,3,0,0">
                          <StackPanel Spacing="5">
                            <Grid ColumnDefinitions="140,*,Auto">
                              <TextBlock Text="{Binding Name}"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource Studio.TextPrimaryBrush}" />
                              <TextBox Grid.Column="1"
                                       Text="{Binding Value, Mode=TwoWay}"
                                       Classes="InlineValueEditor"
                                       LostFocus="OnTemplateParameterEditorLostFocus"
                                       KeyDown="OnTemplateParameterEditorKeyDown" />
                              <TextBlock Grid.Column="2"
                                         Margin="8,0,0,0"
                                         VerticalAlignment="Center"
                                         Text="{Binding Unit}"
                                         Classes="ToolbarMetaLabel" />
                            </Grid>
                            <TextBlock Text="{Binding Description}"
                                       TextWrapping="Wrap"
                                       Classes="ToolbarSubtleText" />
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasValidationMessage}">
                              <TextBlock Text="{Binding ValidationMessage}"
                                         TextWrapping="Wrap"
                                         Foreground="#C96B22" />
                              <TextBlock Grid.Column="1"
                                         Text="{Binding RangeLabel}"
                                         Classes="ToolbarMetaLabel"
                                         VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="{Binding RangeLabel}"
                                       Classes="ToolbarMetaLabel"
                                       IsVisible="{Binding HasNoValidationMessage}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border Classes="AssistantContextCard">
                    <TextBlock Text="{Binding SelectedTemplateWorkflowHint}"
                               TextWrapping="Wrap"
                               Classes="AssistantContextSecondary" />
                  </Border>
                  <Border Classes="AssistantContextCard">
                    <TextBlock Text="{Binding TemplateStatus}"
                               TextWrapping="Wrap"
                               Classes="AssistantContextSecondary" />
                  </Border>
                  <Border Classes="AssistantContextCard">
                    <StackPanel Spacing="6">
                      <TextBlock Text="ACL preview"
                                 Classes="AssistantContextPrimary" />
                      <TextBox Text="{Binding SelectedTemplateCommandPreview}"
                               IsReadOnly="True"
                               AcceptsReturn="True"
                               TextWrapping="Wrap"
                               MinHeight="84"
                               FontFamily="Consolas, Cascadia Mono, monospace"
                               Classes="DocumentTextView" />
                    </StackPanel>
                  </Border>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Generate Template Part"
                            Classes="AssistantApplyButton"
                            IsEnabled="{Binding CanApplySelectedTemplate}"
                            Click="OnApplyTemplateClick" />
                    <Button Content="Generate + Prepare"
                            Classes="AssistantSecondaryButton"
                            IsEnabled="{Binding CanApplySelectedTemplate}"
                            Click="OnApplyTemplateAndPrepareClick" />
                    <Button Content="Ask Copilot"
                            Classes="AssistantSecondaryButton"
                            Click="OnTemplateCopilotClick" />
                    <Button Content="Open Copilot"
                            Classes="AssistantSecondaryButton"
                            Click="OnOpenAssistantWorkspaceClick" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Grid.RowSpan="3"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      MaxWidth="520"
                      Classes="ViewportSketchSessionCard"
                      IsVisible="{Binding IsPrepareOverlayVisible}">
                <StackPanel Spacing="10" Width="480">
                  <TextBlock Text="Prepare &amp; Export"
                             Classes="ViewportSessionTitle" />
                  <TextBlock Text="{Binding PrepareWorkspaceSummary}"
                             TextWrapping="Wrap"
                             Classes="ViewportSessionSummary" />
                  <Border Classes="AssistantContextCard">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Active part snapshot"
                                 Classes="AssistantContextPrimary" />
                      <TextBlock Text="{Binding PrepareWorkspaceTemplateSnapshot}"
                                 TextWrapping="Wrap"
                                 Classes="AssistantContextSecondary" />
                    </StackPanel>
                  </Border>
                  <Border Classes="AssistantContextCard">
                    <TextBlock Text="{Binding PrepareWorkspaceWarnings}"
                               TextWrapping="Wrap"
                               Classes="AssistantContextSecondary" />
                  </Border>
                  <Border Classes="AssistantContextCard">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Manufacturing note"
                                 Classes="AssistantContextPrimary" />
                      <TextBlock Text="{Binding PrepareWorkspaceManufacturingNotes}"
                                 TextWrapping="Wrap"
                                 Classes="AssistantContextSecondary" />
                    </StackPanel>
                  </Border>
                  <Border Classes="AssistantContextCard">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Export target"
                                 Classes="AssistantContextPrimary" />
                      <TextBlock Text="{Binding PrepareWorkspaceExportTarget}"
                                 Foreground="{DynamicResource Studio.TextPrimaryBrush}" />
                      <TextBlock Text="{Binding PrepareWorkspaceActionHint}"
                                 TextWrapping="Wrap"
                                 Classes="AssistantContextSecondary" />
                    </StackPanel>
                  </Border>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Export STL / OBJ"
                            Classes="AssistantApplyButton"
                            IsEnabled="{Binding CanExportCurrentPart}"
                            Click="OnPrepareExportClick" />
                    <Button Content="Export All (STL + OBJ)"
                            Classes="AssistantApplyButton"
                            IsEnabled="{Binding CanExportCurrentPart}"
                            Click="OnExportAllFormatsClick" />
                    <Button Content="Ask Copilot"
                            Classes="AssistantSecondaryButton"
                            Click="OnPrepareCopilotClick" />
                    <Button Content="Templates"
                            Classes="AssistantSecondaryButton"
                            Click="OnOpenTemplatesWorkspaceClick" />
                    <Button Content="Back to Part Studio"
                            Classes="AssistantSecondaryButton"
                            Click="OnOpenPartStudioWorkspaceClick" />
                  </StackPanel>
                  <Border Classes="AssistantContextCard"
                          IsVisible="{Binding HasPrepareWorkspaceChecks}">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Readiness checklist"
                                 Classes="AssistantContextPrimary" />
                      <ItemsControl ItemsSource="{Binding PrepareWorkspaceChecks}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:PrepareChecklistItem">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,2">
                              <TextBlock Text="{Binding Level}"
                                         Classes="ToolbarMetaLabel"
                                         VerticalAlignment="Top" />
                              <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="1">
                                <TextBlock Text="{Binding Title}"
                                           Foreground="{DynamicResource Studio.TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Detail}"
                                           TextWrapping="Wrap"
                                           Classes="ToolbarSubtleText" />
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                  <Border Classes="AssistantContextCard"
                          IsVisible="{Binding HasExportJobs}">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Recent exports"
                                 Classes="AssistantContextPrimary" />
                      <ItemsControl ItemsSource="{Binding ExportJobs}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:ExportJobViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,2">
                              <TextBlock Text="{Binding Format}"
                                         Classes="ToolbarMetaLabel"
                                         VerticalAlignment="Center" />
                              <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="1">
                                <TextBlock Text="{Binding FileName}"
                                           Foreground="{DynamicResource Studio.TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Scope}"
                                           Classes="ToolbarSubtleText" />
                              </StackPanel>
                              <TextBlock Grid.Column="2"
                                         Text="{Binding Timestamp}"
                                         Classes="ToolbarMetaLabel"
                                         VerticalAlignment="Center" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </StackPanel>
               </Border>

              <Border Grid.RowSpan="3"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      MaxWidth="580"
                      Classes="ViewportSketchSessionCard"
                      IsVisible="{Binding IsPartStudioEmptyStateVisible}">
                <StackPanel Spacing="14" Width="540">
                  <TextBlock Text="Create your first part"
                             FontSize="18"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource Studio.TextPrimaryBrush}" />
                  <TextBlock Text="This part studio is empty. Choose a path below to create geometry — it will appear in the viewport and project tree."
                             TextWrapping="Wrap"
                             Classes="ViewportSessionSummary" />
                  <WrapPanel>
                    <Button Content="Use a template"
                            Margin="0,0,8,8"
                            Classes="AssistantApplyButton"
                            Click="OnOpenTemplatesWorkspaceClick" />
                    <Button Content="Create primitive"
                            Tag="box"
                            Margin="0,0,8,8"
                            Classes="AssistantSecondaryButton"
                            IsEnabled="{Binding CanPrimitiveTools}"
                            Click="OnPrimitiveMenuItemClick" />
                    <Button Content="Start a sketch"
                            Margin="0,0,8,8"
                            Classes="AssistantSecondaryButton"
                            IsEnabled="{Binding CanSketchPrimaryAction}"
                            Click="OnSketchPrimaryClick" />
                    <Button Content="Open sample"
                            Margin="0,0,8,8"
                            Classes="AssistantSecondaryButton"
                            Click="OnOpenSampleTemplateClick" />
                    <Button Content="Configure AI"
                            Margin="0,0,8,8"
                            Classes="AssistantSecondaryButton"
                            Click="OnAiSettingsClick" />
                  </WrapPanel>
                  <TextBlock Text="Export becomes available after at least one visible body exists. Supported export formats in this build: STL and OBJ."
                             TextWrapping="Wrap"
                             Classes="ToolbarSubtleText" />
                </StackPanel>
              </Border>

              <Border Grid.RowSpan="3"
                      Margin="18"
                      Padding="18"
                      Classes="StartupBackdrop"
                      IsVisible="{Binding IsStartupPageVisible}">
                <Grid ColumnDefinitions="1.25*,0.95*"
                      RowDefinitions="Auto,*,Auto">
                  <Border Grid.Column="0"
                          Grid.RowSpan="2"
                          Margin="0,0,16,0"
                          Classes="StartupHeroCard">
                    <Grid RowDefinitions="Auto,Auto,*">
                      <StackPanel Spacing="8">
                        <Border Classes="StartupChip"
                                HorizontalAlignment="Left">
                          <TextBlock Text="Launchpad"
                                     Classes="ToolbarMetaLabel" />
                        </Border>
                        <TextBlock Text="{Binding StartupPageTitle}"
                                   Classes="StartupTitleText" />
                        <TextBlock Text="{Binding StartupPageSummary}"
                                   MaxWidth="560"
                                   TextWrapping="Wrap"
                                   Classes="StartupBodyText" />
                      </StackPanel>

                      <Grid Grid.Row="1"
                            ColumnDefinitions="*,*"
                            RowDefinitions="Auto,Auto,Auto"
                            Margin="0,16,0,0">
                        <Button Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,6,6"
                                Classes="StartupActionCard"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Click="OnNewLargeProjectClick">
                          <StackPanel Spacing="4">
                            <TextBlock Text="New Large Project"
                                       Classes="StartupActionTitle" />
                            <TextBlock Text="Creates a saved local project with multiple part studios for longer work."
                                       TextWrapping="Wrap"
                                       Classes="StartupActionSummary" />
                          </StackPanel>
                        </Button>

                        <Button Grid.Row="0"
                                Grid.Column="1"
                                Margin="6,0,0,6"
                                Classes="StartupActionCard"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Click="OnNewStandardProjectClick">
                          <StackPanel Spacing="4">
                            <TextBlock Text="New Standard Project"
                                       Classes="StartupActionTitle" />
                            <TextBlock Text="Creates a normal saved project with one active part studio."
                                       TextWrapping="Wrap"
                                       Classes="StartupActionSummary" />
                          </StackPanel>
                        </Button>

                        <Button Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,6,6,0"
                                Classes="StartupActionCard"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Click="OnNewQuickDesignClick">
                          <StackPanel Spacing="4">
                            <TextBlock Text="New Quick Design"
                                       Classes="StartupActionTitle" />
                            <TextBlock Text="Fast saved local scratch project for small household or repair parts."
                                       TextWrapping="Wrap"
                                       Classes="StartupActionSummary" />
                          </StackPanel>
                        </Button>

                        <Button Grid.Row="1"
                                Grid.Column="1"
                                Margin="6,6,0,0"
                                Classes="StartupActionCard"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Click="OnOpenProjectClick">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Open Existing Project"
                                       Classes="StartupActionTitle" />
                            <TextBlock Text="Open a `.umxproj` file and restore its studios, exports, and UI state."
                                       TextWrapping="Wrap"
                                       Classes="StartupActionSummary" />
                          </StackPanel>
                        </Button>

                        <Button Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Margin="0,12,0,0"
                                Classes="StartupActionCard"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Click="OnOpenSampleTemplateClick">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Open Sample / Template"
                                       Classes="StartupActionTitle" />
                            <TextBlock Text="Creates a real sample mounting plate with a hole using the local recipe pipeline."
                                       TextWrapping="Wrap"
                                       Classes="StartupActionSummary" />
                          </StackPanel>
                        </Button>
                      </Grid>

                      <Border Grid.Row="2"
                              Margin="0,16,0,0"
                              Classes="StartupStatusStrip">
                        <Grid ColumnDefinitions="*,*,*">
                          <StackPanel Spacing="2">
                            <TextBlock Text="Local"
                                       Classes="ToolbarMetaLabel" />
                            <TextBlock Text="{Binding LocalCadStatusText}"
                                       TextWrapping="Wrap"
                                       Classes="StartupStatusText" />
                          </StackPanel>
                          <StackPanel Grid.Column="1"
                                      Margin="12,0,0,0"
                                      Spacing="2">
                            <TextBlock Text="Project"
                                        Classes="ToolbarMetaLabel" />
                            <TextBlock Text="{Binding ProductProjectTypeLabel}"
                                        TextWrapping="Wrap"
                                        Classes="StartupStatusText" />
                          </StackPanel>
                          <StackPanel Grid.Column="2"
                                      Margin="12,0,0,0"
                                      Spacing="2">
                            <TextBlock Text="Language"
                                       Classes="ToolbarMetaLabel" />
                            <TextBlock Text="{Binding ModelingLanguageName}"
                                       TextWrapping="Wrap"
                                       Classes="StartupStatusText" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </Grid>
                  </Border>

                  <Border Grid.Column="1"
                          Classes="StartupSideCard">
                    <StackPanel Spacing="10">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding StartupPageAssistantTitle}"
                                   Classes="StartupSectionTitle" />
                        <TextBlock Text="{Binding StartupPageAssistantSummary}"
                                   TextWrapping="Wrap"
                                   Classes="StartupBodyText" />
                      </StackPanel>
                      <Border Classes="AssistantContextCard">
                        <StackPanel Spacing="6">
                          <TextBlock Text="Current project"
                                     Classes="AssistantContextPrimary" />
                          <TextBlock Text="{Binding ProjectTitle}"
                                     TextWrapping="Wrap"
                                     Classes="AssistantContextSecondary" />
                          <TextBlock Text="{Binding ProductProjectSummary}"
                                     TextWrapping="Wrap"
                                     Classes="ToolbarSubtleText" />
                        </StackPanel>
                      </Border>
                      <Border Classes="AssistantContextCard">
                        <StackPanel Spacing="6">
                          <TextBlock Text="Copilot status"
                                     Classes="AssistantContextPrimary" />
                          <TextBlock Text="{Binding AiConfigurationStatusText}"
                                     TextWrapping="Wrap"
                                     Classes="AssistantContextSecondary" />
                          <TextBlock Text="Use Copilot for template suggestions, printable design checks, or ACL drafting. Local workflows still work even when no provider is connected."
                                     TextWrapping="Wrap"
                                     Classes="AssistantContextSecondary" />
                        </StackPanel>
                      </Border>
                      <WrapPanel>
                        <Button Content="Mounting plate prompt"
                                Tag="Help me create a printable mounting plate with four holes and safe wall thickness."
                                Margin="0,0,6,6"
                                Classes="AssistantSecondaryButton"
                                Click="OnAssistantSuggestionClick" />
                        <Button Content="Box + lid prompt"
                                Tag="Design a simple electronics box with a matching lid and starter dimensions for FDM printing."
                                Margin="0,0,6,6"
                                Classes="AssistantSecondaryButton"
                                Click="OnAssistantSuggestionClick" />
                        <Button Content="ACL starter"
                                Tag="Write an ACL starter for a practical maker part and explain the parameter choices."
                                Margin="0,0,6,6"
                                Classes="AssistantSecondaryButton"
                                Click="OnAssistantSuggestionClick" />
                      </WrapPanel>
                      <WrapPanel>
                        <Button Content="Create named project"
                                Margin="0,0,6,6"
                                Classes="AssistantApplyButton"
                                Click="OnNewProjectDialogClick" />
                        <Button Content="Open Copilot"
                                Margin="0,0,6,6"
                                Classes="AssistantSecondaryButton"
                                Click="OnOpenAssistantWorkspaceClick" />
                        <Button Content="Open project"
                                Margin="0,0,6,6"
                                Classes="AssistantSecondaryButton"
                                Click="OnOpenProjectClick" />
                        <Button Content="Enter Part Studio"
                                Margin="0,0,6,6"
                                Classes="AssistantSecondaryButton"
                                Click="OnDismissStartupPageClick" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="1"
                          Grid.Row="1"
                          Margin="0,16,0,0"
                          Classes="StartupSideCard">
                    <StackPanel Spacing="10">
                      <StackPanel Spacing="4">
                        <TextBlock Text="Featured starter templates"
                                   Classes="StartupSectionTitle" />
                        <TextBlock Text="Open a parametric template directly in the Templates workspace, adjust its dimensions, then generate it into the active part studio."
                                   TextWrapping="Wrap"
                                   Classes="StartupBodyText" />
                      </StackPanel>
                      <ItemsControl ItemsSource="{Binding StartupFeaturedTemplates}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="services:MakerTemplateDefinition">
                            <Button Tag="{Binding Id}"
                                    Margin="0,0,0,6"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Classes="AssistantSecondaryButton"
                                    Click="OnStartupTemplateClick">
                              <StackPanel Spacing="1">
                                <TextBlock Text="{Binding DisplayName}" />
                                <TextBlock Text="{Binding Description}"
                                           TextWrapping="Wrap"
                                           Classes="ToolbarMetaLabel" />
                              </StackPanel>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Border Classes="AssistantContextCard">
                        <StackPanel Spacing="6">
                          <TextBlock Text="Quick design recipes"
                                     Classes="AssistantContextPrimary" />
                          <WrapPanel>
                            <Button Content="Bracket" Tag="bracket" Margin="0,0,6,6" Classes="AssistantSecondaryButton" Click="OnQuickDesignUseCaseClick" />
                            <Button Content="Spacer" Tag="spacer" Margin="0,0,6,6" Classes="AssistantSecondaryButton" Click="OnQuickDesignUseCaseClick" />
                            <Button Content="Clip" Tag="clip" Margin="0,0,6,6" Classes="AssistantSecondaryButton" Click="OnQuickDesignUseCaseClick" />
                            <Button Content="Mount" Tag="mount" Margin="0,0,6,6" Classes="AssistantSecondaryButton" Click="OnQuickDesignUseCaseClick" />
                            <Button Content="Enclosure" Tag="enclosure" Margin="0,0,6,6" Classes="AssistantSecondaryButton" Click="OnQuickDesignUseCaseClick" />
                            <Button Content="Adapter" Tag="adapter" Margin="0,0,6,6" Classes="AssistantSecondaryButton" Click="OnQuickDesignUseCaseClick" />
                          </WrapPanel>
                        </StackPanel>
                      </Border>
                      <Border Classes="AssistantContextCard">
                        <StackPanel Spacing="6">
                          <TextBlock Text="Recovery"
                                     Classes="AssistantContextPrimary" />
                          <TextBlock Text="{Binding StartupRecoverySummary}"
                                     TextWrapping="Wrap"
                                     Classes="AssistantContextSecondary" />
                          <WrapPanel IsVisible="{Binding HasRecoveryAvailable}">
                            <Button Content="Restore autosave"
                                    Margin="0,0,6,6"
                                    Classes="AssistantApplyButton"
                                    Click="OnRestoreAutosaveClick" />
                            <Button Content="Discard autosave"
                                    Margin="0,0,6,6"
                                    Classes="AssistantSecondaryButton"
                                    Click="OnDiscardAutosaveClick" />
                          </WrapPanel>
                        </StackPanel>
                      </Border>
                      <Border Height="1" Background="{DynamicResource Studio.BorderBrush}" Opacity="0.7" />
                      <Border Classes="AssistantContextCard">
                        <StackPanel Spacing="6">
                          <TextBlock Text="Launch behavior"
                                     Classes="AssistantContextPrimary" />
                          <CheckBox Content="Show this home screen on launch"
                                    IsChecked="{Binding ShowStartupPageOnLaunch, Mode=TwoWay}"
                                    Classes="FeatureDialogCheckBox" />
                          <TextBlock Text="{Binding StartupLaunchPreferenceSummary}"
                                     TextWrapping="Wrap"
                                     Classes="AssistantContextSecondary" />
                        </StackPanel>
                      </Border>
                      <Border Height="1" Background="{DynamicResource Studio.BorderBrush}" Opacity="0.7" />
                      <StackPanel Spacing="4">
                        <TextBlock Text="Getting Started"
                                   Classes="StartupSectionTitle" />
                        <TextBlock Text="Quick start guide for first-time makers."
                                   TextWrapping="Wrap"
                                   Classes="StartupBodyText" />
                      </StackPanel>
                      <ItemsControl ItemsSource="{Binding GetStartedItems}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:GetStartedItem">
                            <Border Classes="GetStartedCard" Margin="0,0,0,6">
                              <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Title}" Classes="GetStartedItemChecked" />
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Classes="GetStartedItem" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Border Height="1" Background="{DynamicResource Studio.BorderBrush}" Opacity="0.7" />
                      <StackPanel Spacing="4">
                        <TextBlock Text="Recent projects"
                                   Classes="StartupSectionTitle" />
                        <TextBlock Text="Jump back into active projects without leaving the studio shell."
                                   TextWrapping="Wrap"
                                   Classes="StartupBodyText" />
                      </StackPanel>
                      <ItemsControl ItemsSource="{Binding RecentDocumentItems}"
                                    IsVisible="{Binding HasRecentDocumentItems}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:RecentDocumentItemViewModel">
                            <Button Tag="{Binding FullPath}"
                                    Margin="0,0,0,6"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Classes="AssistantSecondaryButton"
                                    ToolTip.Tip="{Binding FullPath}"
                                    Click="OnRecentDocumentLibraryClick">
                              <StackPanel Spacing="1">
                                <TextBlock Text="{Binding DisplayName}" />
                                <TextBlock Text="{Binding Summary}"
                                           Classes="ToolbarMetaLabel" />
                              </StackPanel>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="No recent projects yet. Create or save a project and it will appear here immediately."
                                  TextWrapping="Wrap"
                                  Classes="ToolbarSubtleText"
                                  IsVisible="{Binding HasNoRecentDocumentItems}" />
                    </StackPanel>
                  </Border>

                  <Border Grid.Row="2"
                          Grid.ColumnSpan="2"
                          Margin="0,16,0,0"
                          Classes="StartupCodeCard">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="8">
                        <TextBlock Text="{Binding ModelingLanguageName}"
                                   Classes="StartupSectionTitle" />
                        <TextBlock Text="{Binding ModelingLanguageSummary}"
                                   TextWrapping="Wrap"
                                   Classes="StartupBodyText" />
                        <TextBox Text="{Binding ModelingLanguageSample}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 FontFamily="Consolas, Cascadia Mono, monospace"
                                 Classes="StartupCodePreview" />
                      </StackPanel>
                      <StackPanel Grid.Column="1"
                                  Margin="16,0,0,0"
                                  Width="180"
                                  Spacing="8"
                                  VerticalAlignment="Top">
                        <Button Content="Open commands"
                                Classes="AssistantApplyButton"
                                Click="OnCommandPaletteClick" />
                        <Button Content="Enter studio"
                                Classes="AssistantSecondaryButton"
                                Click="OnDismissStartupPageClick" />
                        <TextBlock Text="Home opens on launch so recent projects and local creation flows are always available."
                                   TextWrapping="Wrap"
                                   Classes="ToolbarSubtleText" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </Grid>
              </Border>

            </Grid>
          </Grid>
        </Border>
      </Grid>

      <GridSplitter Grid.Column="3"
                    Classes="StudioSplitter" />

      <Border Grid.Column="4"
              Classes="StudioPanelSurface"
              Background="{DynamicResource Studio.PanelBackgroundBrush}"
              BorderBrush="{DynamicResource Studio.BorderBrush}"
              BorderThickness="1">
        <TabControl SelectedIndex="{Binding SelectedInspectorTabIndex}"
                    Classes="SidePanelTabControl">
          <TabItem Header="Properties">
            <Grid RowDefinitions="Auto,*" Margin="10">
              <Border Classes="AssistantContextCard" Margin="0,0,0,10">
                <StackPanel Spacing="4">
                  <TextBlock Text="Selection" Classes="AssistantContextPrimary" />
                  <TextBlock Text="{Binding AssistantSelectionSummary}" Classes="AssistantContextSecondary" />
                  <TextBlock Text="{Binding AssistantPlaneSummary}" Classes="AssistantContextSecondary" />
                </StackPanel>
              </Border>

              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Parameters}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ParameterItemViewModel">
                      <Border Classes="ParameterRow">
                        <Grid ColumnDefinitions="110,*">
                          <TextBlock VerticalAlignment="Center"
                                     FontSize="12"
                                     Foreground="{DynamicResource Studio.TextSecondaryBrush}"
                                     Text="{Binding Name}" />
                          <TextBox Grid.Column="1"
                                   Text="{Binding Value, Mode=TwoWay}"
                                   IsReadOnly="{Binding IsReadOnly}"
                                   Classes="InlineValueEditor"
                                   LostFocus="OnParameterEditorLostFocus"
                                   KeyDown="OnParameterEditorKeyDown" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </TabItem>

            <TabItem ToolTip.Tip="Feature recipe">
            <TabItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <svg:Svg Path="avares://My3DApp/Assets/Icons/line.svg"
                         Width="15"
                         Height="15" />
                <TextBlock Text="ACL" />
              </StackPanel>
            </TabItem.Header>
            <Grid RowDefinitions="Auto,Auto,*" Margin="10">
              <Border Classes="RecipeHeaderCard">
                <StackPanel Spacing="4">
                  <TextBlock Text="ACL"
                             Classes="RecipeHeaderTitle" />
                  <TextBlock Text="Command history for the current part studio. Sketches, features, and template output stay readable, ordered, and ready for editing or reuse."
                             TextWrapping="Wrap"
                             Classes="RecipeHeaderSummary" />
                </StackPanel>
              </Border>
              <Border Grid.Row="1"
                      Margin="0,10,0,0"
                      Classes="AssistantContextCard"
                      IsVisible="{Binding HasActiveRecipe}">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding ActiveRecipe.Title}"
                                 Classes="AssistantContextPrimary" />
                      <TextBlock Text="{Binding ActiveRecipe.Description}"
                                 TextWrapping="Wrap"
                                 Classes="AssistantContextSecondary" />
                      <TextBlock Text="{Binding ActiveRecipe.ParameterSummary}"
                                 TextWrapping="Wrap"
                                 Classes="ToolbarMetaLabel" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Run Recipe"
                            Classes="AssistantApplyButton"
                            IsEnabled="{Binding CanRunActiveRecipe}"
                            Click="OnRunActiveRecipeClick" />
                  </Grid>
                  <TextBlock Text="{Binding ActiveRecipe.StatusSummary}"
                             TextWrapping="Wrap"
                             Classes="AssistantHintText" />
                  <ItemsControl ItemsSource="{Binding ActiveRecipe.Steps}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:RecipeStepViewModel">
                        <Grid ColumnDefinitions="76,*,96" Margin="0,2,0,2">
                          <TextBlock Text="{Binding Id}"
                                     Classes="ToolbarMetaLabel" />
                          <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock Text="{Binding Operation}"
                                       Foreground="{DynamicResource Studio.TextPrimaryBrush}" />
                            <TextBlock Text="{Binding Parameters}"
                                       TextWrapping="Wrap"
                                       Classes="ToolbarSubtleText" />
                            <TextBlock Text="{Binding Error}"
                                       TextWrapping="Wrap"
                                       Foreground="#C96B22"
                                       IsVisible="{Binding HasError}" />
                          </StackPanel>
                          <TextBlock Grid.Column="2"
                                     Text="{Binding Status}"
                                     Classes="ToolbarMetaLabel"
                                     HorizontalAlignment="Right" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding ActiveRecipe.ExportHints}"
                             TextWrapping="Wrap"
                             Classes="ToolbarSubtleText" />
                </StackPanel>
              </Border>
              <TextBlock Grid.Row="1"
                         Margin="0,10,0,0"
                         Text="No active recipe yet. Use AI / Recipe → Open Sample Recipe, click a recipe in Copilot, or describe a local part prompt."
                         TextWrapping="Wrap"
                         Classes="ToolbarSubtleText"
                         IsVisible="{Binding HasNoActiveRecipe}" />
              <TextBox Grid.Row="2"
                       Margin="0,10,0,0"
                       Text="{Binding CodeText}"
                       IsReadOnly="True"
                       AcceptsReturn="True"
                       TextWrapping="NoWrap"
                       FontFamily="Consolas, Cascadia Mono, monospace"
                       Classes="DocumentTextView" />
            </Grid>
          </TabItem>

          <TabItem>
            <TabItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <svg:Svg Path="avares://My3DApp/Assets/Icons/focus.svg"
                         Width="14"
                         Height="14" />
                <TextBlock Text="Copilot" />
              </StackPanel>
            </TabItem.Header>
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" Margin="10,8,10,8">

              <!-- Header: title + Recipes toggle + Config toggle + Refresh + Clear -->
              <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                <TextBlock Text="Design Copilot"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Studio.TextMutedBrush}"
                           VerticalAlignment="Center" />
                <ToggleButton x:Name="RecipesToggle"
                              Grid.Column="1"
                              Margin="0,0,6,0"
                              Content="Recipes"
                              Classes="AssistantLinkButton"
                              IsChecked="False"
                              ToolTip.Tip="Insert a standard part recipe" />
                <ToggleButton x:Name="ConfigToggle"
                              Grid.Column="2"
                              Margin="0,0,6,0"
                              Content="⚙"
                              Classes="AssistantLinkButton"
                              IsChecked="False"
                              ToolTip.Tip="API settings" />
                <Button Grid.Column="3"
                        Margin="0,0,6,0"
                        Content="Refresh"
                        Classes="AssistantLinkButton"
                        Click="OnAssistantRefreshClick" />
                <Button Grid.Column="4"
                        Content="Clear"
                        Classes="AssistantLinkButton"
                        Click="OnAssistantClearClick" />
              </Grid>

              <!-- Row 1: 5-mode segmented selector -->
              <ListBox Grid.Row="1"
                       Margin="0,8,0,0"
                       ItemsSource="{Binding AssistantModes}"
                       SelectedItem="{Binding SelectedAssistantMode}"
                       Classes="AssistantModePills"
                       Background="Transparent"
                       BorderThickness="0"
                       Padding="0">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="4" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <!-- Row 2: Provider status plus key config (details collapsed by default) -->
              <Border Grid.Row="2"
                      Classes="AssistantContextCard"
                      Margin="0,8,0,0">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding AssistantProviderStatusLine}"
                             TextWrapping="Wrap"
                             Classes="ToolbarMetaLabel" />
                  <TextBlock Text="{Binding LastAssistantRequestStatus}"
                             TextWrapping="Wrap"
                             Classes="ToolbarMetaLabel" />
                  <TextBlock Text="{Binding LastAssistantError}"
                             TextWrapping="Wrap"
                             Foreground="#C96B22"
                             IsVisible="{Binding HasAssistantLastError}" />
                  <WrapPanel>
                    <Button Content="Suggest template"
                            Tag="Suggest the best starter template for the current task and explain why."
                            Margin="0,0,4,4"
                            Padding="9,4"
                            FontSize="11"
                            Classes="AssistantLinkButton"
                            Click="OnAssistantSuggestionClick" />
                    <Button Content="Make printable"
                            Tag="Review the current part and tell me how to make it easier to 3D print."
                            Margin="0,0,4,4"
                            Padding="9,4"
                            FontSize="11"
                            Classes="AssistantLinkButton"
                            Click="OnAssistantSuggestionClick" />
                    <Button Content="Explain selection"
                            Tag="Explain the current selection and suggest the next CAD step."
                            Margin="0,0,4,4"
                            Padding="9,4"
                            FontSize="11"
                            Classes="AssistantLinkButton"
                            Click="OnAssistantSuggestionClick" />
                    <Button Content="Draft ACL"
                            Tag="Draft an ACL starting point for a useful maker part based on the current workspace."
                            Margin="0,0,4,4"
                            Padding="9,4"
                            FontSize="11"
                            Classes="AssistantLinkButton"
                            Click="OnAssistantSuggestionClick" />
                  </WrapPanel>
                  <StackPanel Spacing="6"
                              IsVisible="{Binding #ConfigToggle.IsChecked}">
                    <Grid ColumnDefinitions="*,*">
                      <ComboBox ItemsSource="{Binding AssistantProviders}"
                                SelectedItem="{Binding SelectedAssistantProvider}"
                                Classes="AssistantSelector" />
                      <ComboBox Grid.Column="1"
                                Margin="6,0,0,0"
                                ItemsSource="{Binding AssistantModels}"
                                SelectedItem="{Binding SelectedAssistantModel}"
                                Classes="AssistantSelector" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBox Text="{Binding AssistantKeyInput, Mode=TwoWay}"
                               Watermark="API key (env or paste here)"
                               PasswordChar="*"
                               Classes="AssistantKeyInput" />
                      <Border Grid.Column="1"
                              Margin="6,0,0,0"
                              Classes="AssistantStatusBadge"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding AssistantStatusBadge}"
                                   FontSize="10"
                                   FontWeight="SemiBold" />
                      </Border>
                    </Grid>
                    <TextBox Text="{Binding SelectedAssistantBaseUrl, Mode=TwoWay}"
                             Watermark="Optional base URL (blank uses provider default)"
                             Classes="AssistantKeyInput" />
                    <TextBlock Text="{Binding AssistantConfigurationSummary}"
                               TextWrapping="Wrap"
                               Classes="AssistantHintText" />
                    <TextBlock Text="{Binding AssistantStatus}"
                               TextWrapping="Wrap"
                               Classes="ToolbarMetaLabel" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- Row 3: Recipe catalog (collapsed by default) -->
              <Border Grid.Row="3"
                      Classes="AssistantContextCard"
                      Margin="0,8,0,0"
                      IsVisible="{Binding #RecipesToggle.IsChecked}">
                <StackPanel Spacing="6">
                  <TextBlock Text="Insert a standard part — click to fill the prompt with sample parameters, then edit &amp; send."
                             Classes="AssistantHintText"
                             TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding AssistantRecipes}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="services:CadRecipe">
                        <Button Content="{Binding DisplayName}"
                                Tag="{Binding Name}"
                                Margin="0,0,4,4"
                                Padding="9,4"
                                FontSize="11"
                                Classes="AssistantLinkButton"
                                ToolTip.Tip="{Binding Description}"
                                Click="OnAssistantRecipeClick" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <!-- Row 4: Message area (fills space) -->
              <Border Grid.Row="4"
                      Classes="AssistantMessagesHost"
                      Margin="0,8,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel Spacing="0">
                    <!-- Inactive / unconfigured notice -->
                    <Border Classes="AssistantInactiveCard"
                            Margin="0,0,0,8"
                            IsVisible="{Binding ShowAssistantInactiveState}">
                      <StackPanel Spacing="6">
                        <TextBlock Text="{Binding AssistantInactiveTitle}"
                                   Classes="AssistantContextPrimary" />
                        <TextBlock Text="{Binding AssistantInactiveSummary}"
                                   TextWrapping="Wrap"
                                   Classes="AssistantContextSecondary" />
                        <WrapPanel>
                          <Button Content="Configure AI"
                                  Margin="0,0,6,6"
                                  Classes="AssistantSecondaryButton"
                                  Click="OnAiSettingsClick" />
                          <Button Content="Use templates"
                                  Margin="0,0,6,6"
                                  Classes="AssistantSecondaryButton"
                                  Click="OnOpenTemplatesWorkspaceClick" />
                          <Button Content="Run local recipe"
                                  Margin="0,0,6,6"
                                  Classes="AssistantSecondaryButton"
                                  Click="OnOpenSampleRecipeClick" />
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                    <!-- Message log -->
                    <ItemsControl ItemsSource="{Binding AssistantMessages}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:AssistantMessageViewModel">
                          <Border Classes="AssistantMessageRow">
                            <StackPanel Spacing="2">
                              <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Text="{Binding RoleBadge}"
                                           Classes="AssistantRoleBadge"
                                           Margin="0,0,6,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TimestampText}"
                                           Classes="AssistantTimestamp"
                                           HorizontalAlignment="Right" />
                              </Grid>
                              <TextBlock Text="{Binding Content}"
                                         TextWrapping="Wrap"
                                         FontSize="11.5"
                                         Foreground="{DynamicResource Studio.TextPrimaryBrush}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
              </Border>

              <!-- Row 5: Pending command action chip -->
              <Border Grid.Row="5"
                      Classes="AssistantPendingCard"
                      Margin="0,6,0,0"
                      IsVisible="{Binding HasPendingCommand}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding PendingCommandSummary}"
                             VerticalAlignment="Center"
                             TextWrapping="Wrap"
                             FontSize="11" />
                  <Button Grid.Column="1"
                          Margin="8,0,0,0"
                          Content="Apply"
                          Classes="AssistantApplyButton"
                          IsEnabled="{Binding CanApplyPendingCommand}"
                          Click="OnAssistantApplyCommandClick" />
                </Grid>
              </Border>

              <!-- Row 6: Input bar -->
              <Grid Grid.Row="6" ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                <TextBox x:Name="AssistantInputBox"
                         Grid.Column="0"
                         Margin="0,0,6,0"
                         Text="{Binding AssistantInput, Mode=TwoWay}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="40"
                         MaxHeight="100"
                         Watermark="Describe a bracket, spacer, mount, cutout, or ask for a CAD step..."
                         Classes="AssistantInputBox"
                         KeyDown="OnAssistantInputKeyDown" />
                <Button Grid.Column="1"
                        Content="Send"
                        Classes="AssistantSendButton"
                        IsEnabled="{Binding CanSendAssistant}"
                        VerticalAlignment="Bottom"
                        Click="OnAssistantSendClick" />
              </Grid>
            </Grid>
          </TabItem>
        </TabControl>
      </Border>
    </Grid>
  </DockPanel>
</Window>
