<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">18</CornerRadius>

    <SolidColorBrush x:Key="Studio.WindowBackgroundBrush" Color="#11161d" />
    <SolidColorBrush x:Key="Studio.ToolbarBackgroundBrush" Color="#18202b" />
    <SolidColorBrush x:Key="Studio.PanelBackgroundBrush" Color="#202936" />
    <SolidColorBrush x:Key="Studio.PanelInsetBrush" Color="#19222d" />
    <SolidColorBrush x:Key="Studio.ViewportBackgroundBrush" Color="#0f1721" />
    <SolidColorBrush x:Key="Studio.BorderBrush" Color="#3d4a5f" />
    <SolidColorBrush x:Key="Studio.AccentBrush" Color="#59b0ff" />
    <SolidColorBrush x:Key="Studio.TextPrimaryBrush" Color="#eef4fb" />
    <SolidColorBrush x:Key="Studio.TextSecondaryBrush" Color="#d3dceb" />
    <SolidColorBrush x:Key="Studio.TextMutedBrush" Color="#95a3b8" />
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Inter, Arial" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextPrimaryBrush}" />
  </Style>

  <Style Selector="Border.StudioTopChrome">
    <Setter Property="Background" Value="#151d27" />
  </Style>

  <Style Selector="Border.StudioBottomChrome">
    <Setter Property="Background" Value="#161f2a" />
  </Style>

  <Style Selector="Border.StudioPanelSurface">
    <Setter Property="CornerRadius" Value="16" />
  </Style>

  <Style Selector="Border.StudioViewportSurface">
    <Setter Property="CornerRadius" Value="18" />
  </Style>

  <Style Selector="Border.ToolSplitGroup">
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="#1d2530" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>

  <Style Selector="Button.IconToolButton">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Background" Value="#232c3a" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="TextBlock.ToolbarMetaLabel">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextMutedBrush}" />
    <Setter Property="LetterSpacing" Value="0.6" />
  </Style>

  <Style Selector="TextBlock.ToolbarTitleText">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.ToolbarSubtleText">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextMutedBrush}" />
  </Style>

  <Style Selector="TextBlock.ToolbarButtonLabel">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.ModeSwitchShell">
    <Setter Property="Background" Value="#1b2430" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>

  <Style Selector="Border.StudioBrandMark">
    <Setter Property="Width" Value="42" />
    <Setter Property="Height" Value="42" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="#0f1721" />
    <Setter Property="BorderBrush" Value="#314258" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="0 8 20 0 #66000000" />
  </Style>

  <Style Selector="TextBlock.StudioBrandMarkText">
    <Setter Property="Foreground" Value="#eef4fb" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.ToolbarModeChip">
    <Setter Property="Background" Value="#10283d" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="CornerRadius" Value="999" />
  </Style>

  <Style Selector="TextBlock.ToolbarModeChipText">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.AccentBrush}" />
    <Setter Property="LetterSpacing" Value="0.5" />
  </Style>

  <Style Selector="Border.ToolbarCommandStrip">
    <Setter Property="Background" Value="#192430" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="BoxShadow" Value="0 10 26 0 #44000000" />
  </Style>

  <Style Selector="TextBlock.ToolbarGroupLabel">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.ToolbarDivider">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Background" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Opacity" Value="0.65" />
  </Style>

  <Style Selector="Border.ToolbarModeBadge">
    <Setter Property="Background" Value="#0f2a42" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="CornerRadius" Value="999" />
  </Style>

  <Style Selector="TextBlock.ToolbarModeBadgeText">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.AccentBrush}" />
    <Setter Property="LetterSpacing" Value="0.5" />
  </Style>

  <Style Selector="ToggleButton.ModeToggleButton">
    <Setter Property="MinWidth" Value="72" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="Background" Value="{DynamicResource Studio.PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextPrimaryBrush}" />
  </Style>

  <Style Selector="ToggleButton.ModeToggleButton:checked">
    <Setter Property="Background" Value="#1f324b" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.AccentBrush}" />
  </Style>

  <Style Selector="ToggleButton.ThemeToggleButton">
    <Setter Property="MinWidth" Value="56" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <Style Selector="Button.CommandButton">
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.AccentBrush}" />
    <Setter Property="Background" Value="#12314d" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Button.CommandButton:pointerover">
    <Setter Property="Background" Value="#1a4367" />
  </Style>

  <Style Selector="Button.ToolbarActionButton">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinWidth" Value="30" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="Background" Value="{DynamicResource Studio.PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextPrimaryBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.ToolbarActionButton:pointerover">
    <Setter Property="Background" Value="#2c3748" />
  </Style>

  <Style Selector="Button.ToolbarActionButton:pressed">
    <Setter Property="Background" Value="#384860" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.AccentBrush}" />
  </Style>

  <Style Selector="Button.ToolbarActionButton:disabled">
    <Setter Property="Opacity" Value="0.55" />
  </Style>

  <Style Selector="Button.PrimitiveMenuButton">
    <Setter Property="Width" Value="40" />
    <Setter Property="MinWidth" Value="40" />
  </Style>

  <Style Selector="TabControl.ExplorerCodeTabControl TabItem">
    <Setter Property="Padding" Value="9,7" />
  </Style>

  <Style Selector="Border.ViewportFeaturePanel">
    <Setter Property="Background" Value="#27303af4" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="MaxWidth" Value="340" />
  </Style>

  <Style Selector="TextBlock.FeaturePanelTitle">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.FeaturePanelSubtitle">
    <Setter Property="FontSize" Value="10.75" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextMutedBrush}" />
  </Style>

  <Style Selector="Button.FeaturePanelCloseButton">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.FeaturePanelCloseButton:pointerover">
    <Setter Property="Background" Value="#374152" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.FeaturePanelSelectionCard">
    <Setter Property="Background" Value="#2d3440" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,7" />
  </Style>

  <Style Selector="TextBlock.FeaturePanelSectionLabel">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextMutedBrush}" />
  </Style>

  <Style Selector="TextBlock.FeaturePanelSelectionText, TextBlock.FeaturePanelLabel">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextSecondaryBrush}" />
  </Style>

  <Style Selector="NumericUpDown.FeaturePanelInput, ComboBox.FeaturePanelInput">
    <Setter Property="Height" Value="28" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Background" Value="#242b35" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextPrimaryBrush}" />
  </Style>

  <Style Selector="CheckBox.FeaturePanelCheckBox">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextSecondaryBrush}" />
  </Style>

  <Style Selector="TextBlock.FeaturePanelValidation">
    <Setter Property="FontSize" Value="10.75" />
    <Setter Property="Foreground" Value="#fbbf24" />
  </Style>

  <Style Selector="TextBlock.SketchDofStatus">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextMutedBrush}" />
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>
  <Style Selector="TextBlock.SketchDofStatus.DofFullyConstrained">
    <Setter Property="Foreground" Value="#4CAF50" />
  </Style>
  <Style Selector="TextBlock.SketchDofStatus.DofOverconstrained">
    <Setter Property="Foreground" Value="#FF9800" />
  </Style>

  <Style Selector="Border.SketchHintPanel">
    <Setter Property="Background" Value="#1b2430" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MaxWidth" Value="420" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>

  <Style Selector="Window.FeatureDialogWindow">
    <Setter Property="Background" Value="{DynamicResource Studio.ToolbarBackgroundBrush}" />
    <Setter Property="TransparencyLevelHint" Value="None" />
  </Style>

  <Style Selector="Border.FeatureDialogPanel">
    <Setter Property="Background" Value="{DynamicResource Studio.PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="BoxShadow" Value="0 18 44 0 #88000000" />
  </Style>

  <Style Selector="TextBlock.FeatureDialogTitle">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.FeatureDialogSubtitle">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextMutedBrush}" />
  </Style>

  <Style Selector="Border.FeatureDialogTag">
    <Setter Property="Background" Value="{DynamicResource Studio.PanelInsetBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>

  <Style Selector="TextBlock.FeatureDialogTagText">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextMutedBrush}" />
    <Setter Property="LetterSpacing" Value="0.45" />
  </Style>

  <Style Selector="Border.FeatureDialogSectionCard">
    <Setter Property="Background" Value="{DynamicResource Studio.PanelInsetBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="14" />
  </Style>

  <Style Selector="TextBlock.FeatureDialogFieldLabel">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.FeatureDialogValueText">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextSecondaryBrush}" />
  </Style>

  <Style Selector="TextBlock.FeatureDialogHelpText">
    <Setter Property="FontSize" Value="10.75" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextMutedBrush}" />
  </Style>

  <Style Selector="NumericUpDown.FeatureDialogInput, ComboBox.FeatureDialogInput">
    <Setter Property="Height" Value="30" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Background" Value="#242b35" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextPrimaryBrush}" />
  </Style>

  <Style Selector="CheckBox.FeatureDialogCheckBox, RadioButton.FeatureDialogCheckBox">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextSecondaryBrush}" />
  </Style>

  <Style Selector="Border.FeatureDialogUnitChip">
    <Setter Property="Background" Value="{DynamicResource Studio.PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <Style Selector="Button.FeatureDialogButtonPrimary">
    <Setter Property="MinWidth" Value="92" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="Background" Value="#1f324b" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.FeatureDialogButtonSecondary">
    <Setter Property="MinWidth" Value="84" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="Background" Value="{DynamicResource Studio.PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextPrimaryBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.FeatureDialogConfirmBtn">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="#16a34a" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="Content" Value="✓" />
  </Style>
  <Style Selector="Button.FeatureDialogConfirmBtn:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#15803d" />
  </Style>
  <Style Selector="Button.FeatureDialogConfirmBtn:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="#374151" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>

  <Style Selector="Button.FeatureDialogCancelBtn">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="#dc2626" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="Content" Value="✕" />
  </Style>
  <Style Selector="Button.FeatureDialogCancelBtn:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#b91c1c" />
  </Style>

  <Style Selector="Border.FeatureDialogTabBar">
    <Setter Property="Background" Value="{DynamicResource Studio.PanelInsetBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="2" />
  </Style>

  <Style Selector="ToggleButton.FeatureDialogOperationTab">
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextSecondaryBrush}" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ToggleButton.FeatureDialogOperationTab:checked">
    <Setter Property="Background" Value="{DynamicResource Studio.PanelBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.AccentBrush}" />
  </Style>
  <Style Selector="ToggleButton.FeatureDialogOperationTab:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Studio.PanelBackgroundBrush}" />
  </Style>

  <Style Selector="Border.FeatureDialogSelectionField">
    <Setter Property="Background" Value="#162133" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.AccentBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10,7" />
  </Style>

  <Style Selector="TextBlock.FeatureDialogSelectionText">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextSecondaryBrush}" />
  </Style>

  <Style Selector="Border.PartStudioTabBar">
    <Setter Property="MinHeight" Value="32" />
  </Style>

  <Style Selector="Button.PartStudioTab">
    <Setter Property="Height" Value="26" />
    <Setter Property="MinWidth" Value="80" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="CornerRadius" Value="6,6,0,0" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
  </Style>
  <Style Selector="Button.PartStudioTab:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Studio.PanelBackgroundBrush}" />
  </Style>
  <Style Selector="Button.PartStudioTab.active">
    <Setter Property="Background" Value="{DynamicResource Studio.PanelBackgroundBrush}" />
    <Setter Property="BorderThickness" Value="1,1,1,0" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.PartStudioTabClose">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextMutedBrush}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.PartStudioTabClose:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#dc2626" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="Button.PartStudioTabAdd">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.AccentBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
  </Style>
  <Style Selector="Button.PartStudioTabAdd:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Studio.AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="TextBox.DocumentTitleEdit">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="2,1" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBox.DocumentTitleEdit:focus /template/ Border">
    <Setter Property="Background" Value="{DynamicResource Studio.PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Button.ToolbarMiniButton">
    <Setter Property="Height" Value="30" />
    <Setter Property="MinWidth" Value="56" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Background" Value="{DynamicResource Studio.PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.ToolbarMiniButton:pointerover">
    <Setter Property="Background" Value="#374152" />
  </Style>

  <Style Selector="ToggleButton.ToolbarMiniToggle">
    <Setter Property="Height" Value="30" />
    <Setter Property="MinWidth" Value="64" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Background" Value="{DynamicResource Studio.PanelBackgroundBrush}" />
