  <Style Selector="Button.SketchConstraintToolButton:pressed">
    <Setter Property="Background" Value="#d4e2f2" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.AccentBrush}" />
  </Style>

  <Style Selector="TextBox.AssistantKeyInput">
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Background" Value="#ffffff" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="11" />
