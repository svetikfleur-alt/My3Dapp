<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">18</CornerRadius>

    <SolidColorBrush x:Key="Studio.WindowBackgroundBrush" Color="#e9eef5" />
    <SolidColorBrush x:Key="Studio.ToolbarBackgroundBrush" Color="#eef3f9" />
    <SolidColorBrush x:Key="Studio.PanelBackgroundBrush" Color="#fbfcfe" />
    <SolidColorBrush x:Key="Studio.PanelInsetBrush" Color="#f2f6fb" />
    <SolidColorBrush x:Key="Studio.ViewportBackgroundBrush" Color="#dde7f2" />
    <SolidColorBrush x:Key="Studio.BorderBrush" Color="#cdd7e4" />
    <SolidColorBrush x:Key="Studio.AccentBrush" Color="#0a84d8" />
    <SolidColorBrush x:Key="Studio.TextPrimaryBrush" Color="#18212b" />
    <SolidColorBrush x:Key="Studio.TextSecondaryBrush" Color="#4a596d" />
    <SolidColorBrush x:Key="Studio.TextMutedBrush" Color="#6d7b8d" />
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Inter, Arial" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextPrimaryBrush}" />
  </Style>

  <Style Selector="Border.StudioTopChrome">
    <Setter Property="Background" Value="#edf3f9" />
  </Style>

  <Style Selector="Border.StudioBottomChrome">
    <Setter Property="Background" Value="#f1f5fa" />
  </Style>

  <Style Selector="Border.StudioPanelSurface">
    <Setter Property="CornerRadius" Value="16" />
  </Style>

  <Style Selector="Border.StudioViewportSurface">
    <Setter Property="CornerRadius" Value="18" />
  </Style>

  <Style Selector="TextBlock.ToolbarMetaLabel">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextMutedBrush}" />
    <Setter Property="LetterSpacing" Value="0.6" />
  </Style>

  <Style Selector="TextBlock.ToolbarTitleText">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.ToolbarSubtleText">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextMutedBrush}" />
  </Style>

  <Style Selector="TextBlock.ToolbarButtonLabel">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.ModeSwitchShell">
    <Setter Property="Background" Value="{DynamicResource Studio.PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>

  <Style Selector="Border.StudioBrandMark">
    <Setter Property="Width" Value="42" />
    <Setter Property="Height" Value="42" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="#17324d" />
    <Setter Property="BorderBrush" Value="#264b70" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="0 8 20 0 #1c203040" />
  </Style>

  <Style Selector="TextBlock.StudioBrandMarkText">
    <Setter Property="Foreground" Value="#ffffff" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.ToolbarModeChip">
    <Setter Property="Background" Value="#e5f1fd" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="CornerRadius" Value="999" />
  </Style>

  <Style Selector="TextBlock.ToolbarModeChipText">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.AccentBrush}" />
    <Setter Property="LetterSpacing" Value="0.5" />
  </Style>

  <Style Selector="Border.ToolbarCommandStrip">
    <Setter Property="Background" Value="{DynamicResource Studio.PanelInsetBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="BoxShadow" Value="0 10 26 0 #10203320" />
  </Style>

  <Style Selector="TextBlock.ToolbarGroupLabel">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.ToolbarDivider">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Background" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Opacity" Value="0.7" />
  </Style>

  <Style Selector="Border.ToolbarModeBadge">
    <Setter Property="Background" Value="#e5f1fd" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="CornerRadius" Value="999" />
  </Style>

  <Style Selector="TextBlock.ToolbarModeBadgeText">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.AccentBrush}" />
    <Setter Property="LetterSpacing" Value="0.5" />
  </Style>

  <Style Selector="Button.IconToolButton">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Background" Value="{DynamicResource Studio.PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.ToolSplitGroup">
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Studio.PanelBackgroundBrush}" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>

  <Style Selector="Button.ToolSplitMainButton">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="30" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="{DynamicResource Studio.PanelBackgroundBrush}" />
    <Setter Property="Padding" Value="6" />
  </Style>

  <Style Selector="Button.ToolSplitChevronButton">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="30" />
    <Setter Property="BorderThickness" Value="0,0,0,0" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="Background" Value="{DynamicResource Studio.PanelBackgroundBrush}" />
  </Style>

  <Style Selector="Button.ToolSplitChevronButton:pointerover, Button.ToolSplitMainButton:pointerover">
    <Setter Property="Background" Value="#edf3fb" />
  </Style>

  <Style Selector="Button.ToolSplitChevronButton:pressed, Button.ToolSplitMainButton:pressed">
    <Setter Property="Background" Value="#ddeaf9" />
  </Style>

  <Style Selector="ContextMenu.ToolDropdownMenu">
    <Setter Property="Background" Value="#ffffff" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="MinWidth" Value="170" />
    <Setter Property="MaxHeight" Value="220" />
  </Style>

  <Style Selector="MenuItem.ToolDropdownItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextPrimaryBrush}" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <Style Selector="MenuItem.ToolDropdownItem:pointerover">
    <Setter Property="Background" Value="#eaf3fe" />
  </Style>

  <Style Selector="MenuItem.ToolDropdownItem:selected">
    <Setter Property="Background" Value="#dfeeff" />
  </Style>

  <Style Selector="Button.CommandButton">
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.AccentBrush}" />
    <Setter Property="Background" Value="#e7f2fd" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Button.CommandButton:pointerover">
    <Setter Property="Background" Value="#dcedfc" />
  </Style>

  <Style Selector="Button.ToolbarActionButton">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinWidth" Value="30" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="Background" Value="{DynamicResource Studio.PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextPrimaryBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.ToolbarActionButton:pointerover">
    <Setter Property="Background" Value="#e8f0f9" />
  </Style>

  <Style Selector="Button.ToolbarActionButton:pressed">
    <Setter Property="Background" Value="#d8e8f8" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.AccentBrush}" />
  </Style>

  <Style Selector="Button.ToolbarActionButton:disabled">
    <Setter Property="Opacity" Value="0.55" />
  </Style>

  <Style Selector="Button.PrimitiveMenuButton">
    <Setter Property="Width" Value="40" />
    <Setter Property="MinWidth" Value="40" />
  </Style>

  <Style Selector="TabControl.ExplorerCodeTabControl TabItem">
    <Setter Property="Padding" Value="9,7" />
  </Style>

  <Style Selector="Border.ViewportFeaturePanel">
    <Setter Property="Background" Value="rgba(255,255,255,0.97)" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="MaxWidth" Value="340" />
  </Style>

  <Style Selector="TextBlock.FeaturePanelTitle">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.FeaturePanelSubtitle">
    <Setter Property="FontSize" Value="10.75" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextMutedBrush}" />
  </Style>

  <Style Selector="Button.FeaturePanelCloseButton">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.FeaturePanelCloseButton:pointerover">
    <Setter Property="Background" Value="#eef4fc" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.FeaturePanelSelectionCard">
    <Setter Property="Background" Value="#f7f9fc" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,7" />
  </Style>

  <Style Selector="TextBlock.FeaturePanelSectionLabel">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextMutedBrush}" />
  </Style>

  <Style Selector="TextBlock.FeaturePanelSelectionText, TextBlock.FeaturePanelLabel">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextSecondaryBrush}" />
  </Style>

  <Style Selector="NumericUpDown.FeaturePanelInput, ComboBox.FeaturePanelInput">
    <Setter Property="Height" Value="28" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Background" Value="#ffffff" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextPrimaryBrush}" />
  </Style>

  <Style Selector="CheckBox.FeaturePanelCheckBox">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextSecondaryBrush}" />
  </Style>

  <Style Selector="TextBlock.FeaturePanelValidation">
    <Setter Property="FontSize" Value="10.75" />
    <Setter Property="Foreground" Value="#b45309" />
  </Style>

  <Style Selector="TextBlock.SketchDofStatus">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextMutedBrush}" />
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>
  <Style Selector="TextBlock.SketchDofStatus.DofFullyConstrained">
    <Setter Property="Foreground" Value="#2E7D32" />
  </Style>
  <Style Selector="TextBlock.SketchDofStatus.DofOverconstrained">
    <Setter Property="Foreground" Value="#E65100" />
  </Style>

  <Style Selector="Border.SketchHintPanel">
    <Setter Property="Background" Value="{DynamicResource Studio.PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MaxWidth" Value="420" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>

  <Style Selector="Window.FeatureDialogWindow">
    <Setter Property="Background" Value="{DynamicResource Studio.ToolbarBackgroundBrush}" />
    <Setter Property="TransparencyLevelHint" Value="None" />
  </Style>

  <Style Selector="Border.FeatureDialogPanel">
    <Setter Property="Background" Value="{DynamicResource Studio.PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="BoxShadow" Value="0 18 44 0 #18233a38" />
  </Style>

  <Style Selector="TextBlock.FeatureDialogTitle">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.FeatureDialogSubtitle">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextMutedBrush}" />
  </Style>

  <Style Selector="Border.FeatureDialogTag">
    <Setter Property="Background" Value="{DynamicResource Studio.PanelInsetBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>

  <Style Selector="TextBlock.FeatureDialogTagText">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextMutedBrush}" />
    <Setter Property="LetterSpacing" Value="0.45" />
  </Style>

  <Style Selector="Border.FeatureDialogSectionCard">
    <Setter Property="Background" Value="{DynamicResource Studio.PanelInsetBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="14" />
  </Style>

  <Style Selector="TextBlock.FeatureDialogFieldLabel">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.FeatureDialogValueText">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextSecondaryBrush}" />
  </Style>

  <Style Selector="TextBlock.FeatureDialogHelpText">
    <Setter Property="FontSize" Value="10.75" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextMutedBrush}" />
  </Style>

  <Style Selector="NumericUpDown.FeatureDialogInput, ComboBox.FeatureDialogInput">
    <Setter Property="Height" Value="30" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Background" Value="#ffffff" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextPrimaryBrush}" />
  </Style>

  <Style Selector="CheckBox.FeatureDialogCheckBox, RadioButton.FeatureDialogCheckBox">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextSecondaryBrush}" />
  </Style>

  <Style Selector="Border.FeatureDialogUnitChip">
    <Setter Property="Background" Value="{DynamicResource Studio.PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <Style Selector="Button.FeatureDialogButtonPrimary">
    <Setter Property="MinWidth" Value="92" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="Background" Value="#eef4fc" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.FeatureDialogButtonSecondary">
    <Setter Property="MinWidth" Value="84" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="Background" Value="{DynamicResource Studio.PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextPrimaryBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.FeatureDialogConfirmBtn">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="#22c55e" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="Content" Value="✓" />
  </Style>
  <Style Selector="Button.FeatureDialogConfirmBtn:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#16a34a" />
  </Style>
  <Style Selector="Button.FeatureDialogConfirmBtn:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="#9ca3af" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>

  <Style Selector="Button.FeatureDialogCancelBtn">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="#ef4444" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="Content" Value="✕" />
  </Style>
  <Style Selector="Button.FeatureDialogCancelBtn:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#dc2626" />
  </Style>

  <Style Selector="Border.FeatureDialogTabBar">
    <Setter Property="Background" Value="{DynamicResource Studio.PanelInsetBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="2" />
  </Style>

  <Style Selector="ToggleButton.FeatureDialogOperationTab">
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextSecondaryBrush}" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ToggleButton.FeatureDialogOperationTab:checked">
    <Setter Property="Background" Value="{DynamicResource Studio.PanelBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.AccentBrush}" />
  </Style>
  <Style Selector="ToggleButton.FeatureDialogOperationTab:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Studio.PanelBackgroundBrush}" />
  </Style>

  <Style Selector="Border.FeatureDialogSelectionField">
    <Setter Property="Background" Value="#eaf3fd" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.AccentBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10,7" />
  </Style>

  <Style Selector="TextBlock.FeatureDialogSelectionText">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextSecondaryBrush}" />
  </Style>

  <Style Selector="Button.ToolbarMiniButton">
    <Setter Property="Height" Value="30" />
    <Setter Property="MinWidth" Value="56" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Background" Value="{DynamicResource Studio.PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.ToolbarMiniButton:pointerover">
    <Setter Property="Background" Value="#edf3fb" />
  </Style>

  <Style Selector="ToggleButton.ToolbarMiniToggle">
    <Setter Property="Height" Value="30" />
    <Setter Property="MinWidth" Value="64" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Background" Value="{DynamicResource Studio.PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="ToggleButton.ToolbarMiniToggle:checked">
    <Setter Property="Background" Value="#eaf3fe" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.AccentBrush}" />
  </Style>

  <Style Selector="ToggleButton.ToolbarIconToggle">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="Background" Value="{DynamicResource Studio.PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="ToggleButton.ToolbarIconToggle:pointerover">
    <Setter Property="Background" Value="#e8f0f9" />
  </Style>

  <Style Selector="ToggleButton.ToolbarIconToggle:pressed">
    <Setter Property="Background" Value="#d8e8f8" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.AccentBrush}" />
  </Style>

  <Style Selector="ToggleButton.ToolbarIconToggle:checked">
    <Setter Property="Background" Value="#e4f0fd" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.AccentBrush}" />
  </Style>

  <Style Selector="ComboBox.AssistantSelector">
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="Background" Value="{DynamicResource Studio.PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="11.5" />
  </Style>

  <Style Selector="GridSplitter.StudioSplitter">
    <Setter Property="Background" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <Style Selector="GridSplitter.StudioSplitter:pointerover">
    <Setter Property="Background" Value="{DynamicResource Studio.AccentBrush}" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>

  <Style Selector="ToggleButton.ModeToggleButton">
    <Setter Property="MinWidth" Value="72" />
    <Setter Property="Height" Value="30" />
