    <Setter Property="Foreground" Value="{DynamicResource Studio.AccentBrush}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style Selector="TextBlock.AssistantTimestamp">
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextMutedBrush}" />
    <Setter Property="FontSize" Value="10" />
  </Style>

  <Style Selector="Border.RecipeHeaderCard">
    <Setter Property="Background" Value="#f7fafe" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>

  <Style Selector="TextBlock.RecipeHeaderTitle">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.RecipeHeaderSummary">
    <Setter Property="FontSize" Value="10.8" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextMutedBrush}" />
  </Style>

  <Style Selector="TextBox.AssistantInputBox">
    <Setter Property="Background" Value="#ffffff" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="TextBox.DocumentTextView">
    <Setter Property="Background" Value="#f4f8fc" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextPrimaryBrush}" />
  </Style>

  <Style Selector="TextBox.DocumentTextView /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="#f4f8fc" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="TextBlock.AssistantHintText">
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextMutedBrush}" />
    <Setter Property="FontSize" Value="10" />
  </Style>

  <Style Selector="Button.PlaneSelectButton">
    <Setter Property="Background" Value="{DynamicResource Studio.PanelInsetBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.PlaneSelectButton:pointerover">
    <Setter Property="Background" Value="#daeaf8" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.AccentBrush}" />
  </Style>

  <Style Selector="Button.PlaneSelectButtonActive">
    <Setter Property="Background" Value="#cce4f7" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.AccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="Border.SketchSidePanel">
    <Setter Property="Background" Value="{DynamicResource Studio.PanelInsetBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,6,0,0" />
  </Style>

  <Style Selector="TextBlock.SketchSidePanelHeader">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextSecondaryBrush}" />
  </Style>

  <Style Selector="TextBlock.SketchConstraintLabel">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextSecondaryBrush}" />
  </Style>

  <Style Selector="TextBlock.SketchConstraintIcon">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.AccentBrush}" />
    <Setter Property="Width" Value="16" />
  </Style>

  <Style Selector="TextBlock.SketchDimensionLabel">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextSecondaryBrush}" />
    <Setter Property="Width" Value="28" />
  </Style>

  <Style Selector="TextBlock.SketchDimensionUnit">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource Studio.TextMutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="3,0,0,0" />
  </Style>

  <Style Selector="Button.SketchConstraintToolButton">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource Studio.PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Studio.BorderBrush}" />
