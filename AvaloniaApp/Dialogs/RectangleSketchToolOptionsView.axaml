<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="My3DApp.AvaloniaApp.Dialogs.RectangleSketchToolOptionsView">
  <StackPanel Spacing="10">
    <Border Background="{DynamicResource Studio.PanelInsetBrush}"
            BorderBrush="{DynamicResource Studio.BorderBrush}"
            BorderThickness="1"
            Padding="12">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="96,*">
        <TextBlock Text="Tool"
                   FontWeight="SemiBold" />
        <TextBlock Grid.Column="1"
                   Text="Rectangle" />
        <TextBlock Grid.Row="1"
                   Margin="0,10,0,0"
                   Text="Mode"
                   FontWeight="SemiBold" />
        <TextBlock Grid.Row="1"
                   Grid.Column="1"
                   Margin="0,10,0,0"
                   Text="Corner to corner — click one corner, drag to the opposite corner."
                   TextWrapping="Wrap" />
      </Grid>
    </Border>

    <Border Background="{DynamicResource Studio.PanelInsetBrush}"
            BorderBrush="{DynamicResource Studio.BorderBrush}"
            BorderThickness="1"
            Padding="12">
      <StackPanel Spacing="8">
        <TextBlock Text="Draw mode"
                   FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Spacing="6">
          <RadioButton x:Name="CornerModeButton"
                       Content="Corner to corner"
                       IsChecked="True"
                       GroupName="RectMode" />
          <RadioButton x:Name="CenterModeButton"
                       Content="Center to corner"
                       GroupName="RectMode" />
        </StackPanel>
        <TextBlock Text="Confirm to start placing a rectangle in the viewport."
                   Foreground="{DynamicResource Studio.TextMutedBrush}"
                   FontSize="11"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
