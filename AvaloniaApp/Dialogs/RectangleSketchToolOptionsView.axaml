<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="My3DApp.AvaloniaApp.Dialogs.RectangleSketchToolOptionsView">
  <StackPanel Spacing="10">
    <Border Classes="FeatureDialogSectionCard">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="96,*">
        <TextBlock Text="Tool"
                   Classes="FeatureDialogFieldLabel" />
        <TextBlock Grid.Column="1"
                   Classes="FeatureDialogValueText"
                   Text="Rectangle" />
        <TextBlock Grid.Row="1"
                   Margin="0,10,0,0"
                   Text="Mode"
                   Classes="FeatureDialogFieldLabel" />
        <TextBlock Grid.Row="1"
                   Grid.Column="1"
                   Margin="0,10,0,0"
                   Classes="FeatureDialogValueText"
                   TextWrapping="Wrap"
                   Text="Corner to corner — click one corner, drag to the opposite corner." />
      </Grid>
    </Border>

    <Border Classes="FeatureDialogSectionCard">
      <StackPanel Spacing="8">
        <TextBlock Text="Draw mode"
                   Classes="FeatureDialogFieldLabel" />
        <StackPanel Orientation="Horizontal" Spacing="6">
          <RadioButton x:Name="CornerModeButton"
                       Classes="FeatureDialogCheckBox"
                       Content="Corner to corner"
                       IsChecked="True"
                       GroupName="RectMode" />
          <RadioButton x:Name="CenterModeButton"
                       Classes="FeatureDialogCheckBox"
                       Content="Center to corner"
                       GroupName="RectMode" />
        </StackPanel>
        <TextBlock Classes="FeatureDialogHelpText"
                   TextWrapping="Wrap"
                   Text="Confirm to start placing a rectangle in the viewport." />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
