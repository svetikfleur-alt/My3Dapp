<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="My3DApp.AvaloniaApp.Dialogs.RenameDialog"
        Width="320"
        Height="140"
        MinWidth="290"
        MinHeight="125"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Classes="FeatureDialogWindow"
        Title="Rename">
  <Border Classes="FeatureDialogPanel" Margin="0">
    <StackPanel Margin="16,14,16,16" Spacing="0">

      <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
        <TextBlock Classes="FeatureDialogTitle" Text="Rename" VerticalAlignment="Center" />
        <Button x:Name="OkButton"
                Grid.Column="1"
                Classes="FeatureDialogConfirmBtn"
                IsDefault="True"
                Click="OnConfirmClick" />
        <Button Grid.Column="2"
                Margin="6,0,0,0"
                Classes="FeatureDialogCancelBtn"
                IsCancel="True"
                Click="OnCancelClick" />
      </Grid>

      <TextBox x:Name="NameInput"
               Classes="AssistantKeyInput"
               MaxLength="80"
               KeyDown="OnInputKeyDown" />

    </StackPanel>
  </Border>
</Window>
