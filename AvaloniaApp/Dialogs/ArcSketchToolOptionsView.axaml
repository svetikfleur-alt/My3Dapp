<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="My3DApp.AvaloniaApp.Dialogs.ArcSketchToolOptionsView">
  <StackPanel Spacing="10">
    <Border Classes="FeatureDialogSectionCard">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="96,*">
        <TextBlock Text="Tool"
                   Classes="FeatureDialogFieldLabel" />
        <TextBlock Grid.Column="1"
                   Classes="FeatureDialogValueText"
                   Text="Arc" />
        <TextBlock Grid.Row="1"
                   Margin="0,10,0,0"
                   Text="Mode"
                   Classes="FeatureDialogFieldLabel" />
        <TextBlock Grid.Row="1"
                   Grid.Column="1"
                   Margin="0,10,0,0"
                   Classes="FeatureDialogValueText"
                   TextWrapping="Wrap"
                   Text="3-point arc — click start, end, then a through-point." />
      </Grid>
    </Border>

    <Border Classes="FeatureDialogSectionCard">
      <StackPanel Spacing="8">
        <TextBlock Text="Draw mode"
                   Classes="FeatureDialogFieldLabel" />
        <StackPanel Orientation="Horizontal" Spacing="6">
          <RadioButton x:Name="ThreePointButton"
                       Classes="FeatureDialogCheckBox"
                       Content="3-point"
                       IsChecked="True"
                       GroupName="ArcMode" />
          <RadioButton x:Name="CenterStartEndButton"
                       Classes="FeatureDialogCheckBox"
                       Content="Center-start-end"
                       GroupName="ArcMode" />
        </StackPanel>
        <TextBlock Classes="FeatureDialogHelpText"
                   TextWrapping="Wrap"
                   Text="Confirm to begin placing an arc in the viewport." />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
