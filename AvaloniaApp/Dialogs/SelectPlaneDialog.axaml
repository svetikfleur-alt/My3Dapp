<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="My3DApp.AvaloniaApp.Dialogs.SelectPlaneDialog"
        Width="330"
        Height="280"
        MinWidth="300"
        MinHeight="250"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Classes="FeatureDialogWindow"
        Title="Select Plane">
  <Border Classes="FeatureDialogPanel" Margin="0">
    <StackPanel Margin="16,14,16,16" Spacing="0">

      <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
        <TextBlock Classes="FeatureDialogTitle" Text="Sketch Plane" VerticalAlignment="Center" />
        <Button x:Name="OkButton"
                Grid.Column="1"
                Classes="FeatureDialogConfirmBtn"
                IsEnabled="False"
                Click="OnConfirmClick"
                ToolTip.Tip="Start Sketch (Enter)" />
        <Button Grid.Column="2"
                Margin="6,0,0,0"
                Classes="FeatureDialogCancelBtn"
                IsCancel="True"
                Click="OnCancelClick" />
      </Grid>

      <TextBlock Classes="FeatureDialogFieldLabel"
                 Text="Choose a reference plane"
                 Margin="0,0,0,8" />

      <Border Classes="FeatureDialogSectionCard">
        <ListBox x:Name="PlaneListBox"
                 Background="Transparent"
                 BorderThickness="0"
                 DoubleTapped="OnListDoubleTapped" />
      </Border>

    </StackPanel>
  </Border>
</Window>
