<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="My3DApp.AvaloniaApp.Dialogs.FilletFeatureDialog"
        Width="380"
        Height="250"
        MinWidth="350"
        MinHeight="230"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Classes="FeatureDialogWindow"
        Title="Fillet">
  <Border Classes="FeatureDialogPanel" Margin="0">
    <StackPanel Margin="16,14,16,16" Spacing="0">

      <!-- Header: title + confirm/cancel -->
      <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
        <TextBlock Classes="FeatureDialogTitle"
                   Text="Fillet"
                   VerticalAlignment="Center" />
        <Button Grid.Column="1"
                Classes="FeatureDialogConfirmBtn"
                IsDefault="True"
                Click="OnConfirmClick"
                ToolTip.Tip="Confirm (Enter)" />
        <Button Grid.Column="2"
                Margin="6,0,0,0"
                Classes="FeatureDialogCancelBtn"
                IsCancel="True"
                Click="OnCancelClick"
                ToolTip.Tip="Cancel (Esc)" />
      </Grid>

      <!-- Selection field -->
      <TextBlock Classes="FeatureDialogFieldLabel"
                 Text="Edges or body to fillet"
                 Margin="0,0,0,4" />
      <Border Classes="FeatureDialogSelectionField" Margin="0,0,0,10">
        <TextBlock x:Name="SelectionValueTextBlock"
                   Classes="FeatureDialogSelectionText"
                   Text="Selected body" />
      </Border>

      <!-- Parameters -->
      <Border Classes="FeatureDialogSectionCard">
        <Grid ColumnDefinitions="*,72" RowDefinitions="Auto,Auto">
          <TextBlock Text="Radius"
                     Classes="FeatureDialogFieldLabel" />
          <NumericUpDown x:Name="RadiusInput"
                         Classes="FeatureDialogInput"
                         Grid.Row="1"
                         Width="150"
                         HorizontalAlignment="Left"
                         Margin="0,6,0,0"
                         Increment="0.5"
                         Minimum="0.1"
                         Maximum="100"
                         FormatString="0.###" />
          <Border Grid.Column="1"
                  Grid.Row="1"
                  Classes="FeatureDialogUnitChip"
                  Margin="8,6,0,0"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Top">
            <TextBlock HorizontalAlignment="Center" Text="mm" />
          </Border>
        </Grid>
      </Border>

    </StackPanel>
  </Border>
</Window>
