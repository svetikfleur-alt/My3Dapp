<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="My3DApp.AvaloniaApp.Dialogs.LoftFeatureDialog"
        Width="400"
        Height="340"
        MinWidth="370"
        MinHeight="310"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Classes="FeatureDialogWindow"
        Title="Loft">
  <Border Classes="FeatureDialogPanel" Margin="0">
    <StackPanel Margin="16,14,16,16" Spacing="0">

      <!-- Header: title + confirm/cancel -->
      <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
        <TextBlock Classes="FeatureDialogTitle"
                   Text="Loft"
                   VerticalAlignment="Center" />
        <Button x:Name="OkButton"
                Grid.Column="1"
                Classes="FeatureDialogConfirmBtn"
                IsDefault="True"
                Click="OnConfirmClick"
                ToolTip.Tip="Confirm (Enter)" />
        <Button Grid.Column="2"
                Margin="6,0,0,0"
                Classes="FeatureDialogCancelBtn"
                IsCancel="True"
                Click="OnCancelClick"
                ToolTip.Tip="Cancel (Esc)" />
      </Grid>

      <!-- Profile pickers -->
      <Border Classes="FeatureDialogSectionCard" Margin="0,0,0,8">
        <StackPanel Spacing="0">
          <TextBlock Text="First profile"
                     Classes="FeatureDialogFieldLabel"
                     Margin="0,0,0,6" />
          <ComboBox x:Name="ProfileAComboBox"
                    Classes="FeatureDialogInput"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,10" />
          <TextBlock Text="Second profile"
                     Classes="FeatureDialogFieldLabel"
                     Margin="0,0,0,6" />
          <ComboBox x:Name="ProfileBComboBox"
                    Classes="FeatureDialogInput"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,6" />
          <TextBlock x:Name="ProfileHintLabel"
                     Classes="FeatureDialogHelpText"
                     TextWrapping="Wrap"
                     Text="" />
        </StackPanel>
      </Border>

      <!-- Distance -->
      <Border Classes="FeatureDialogSectionCard">
        <Grid ColumnDefinitions="*,72" RowDefinitions="Auto,Auto">
          <TextBlock Text="Distance"
                     Classes="FeatureDialogFieldLabel" />
          <NumericUpDown x:Name="DistanceInput"
                         Classes="FeatureDialogInput"
                         Grid.Row="1"
                         Width="150"
                         HorizontalAlignment="Left"
                         Margin="0,6,0,0"
                         Increment="1"
                         Minimum="0.1"
                         Maximum="10000"
                         FormatString="0.###" />
          <Border Grid.Column="1"
                  Grid.Row="1"
                  Classes="FeatureDialogUnitChip"
                  Margin="8,6,0,0"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Top">
            <TextBlock HorizontalAlignment="Center" Text="mm" />
          </Border>
        </Grid>
      </Border>

    </StackPanel>
  </Border>
</Window>
