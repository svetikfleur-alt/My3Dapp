<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="My3DApp.AvaloniaApp.Dialogs.MirrorFeatureDialog"
        Width="380"
        Height="240"
        MinWidth="350"
        MinHeight="220"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Classes="FeatureDialogWindow"
        Title="Mirror">
  <Border Classes="FeatureDialogPanel" Margin="0">
    <StackPanel Margin="16,14,16,16" Classes="FeatureDialogBodyStack">

      <Grid Classes="FeatureDialogHeaderBar" ColumnDefinitions="*,Auto,Auto">
        <TextBlock Classes="FeatureDialogTitle"
                   Text="Mirror"
                   VerticalAlignment="Center" />
        <Button Grid.Column="1"
                Classes="FeatureDialogConfirmBtn"
                IsDefault="True"
                Click="OnConfirmClick"
                ToolTip.Tip="Confirm (Enter)" />
        <Button Grid.Column="2"
                Margin="6,0,0,0"
                Classes="FeatureDialogCancelBtn"
                IsCancel="True"
                Click="OnCancelClick"
                ToolTip.Tip="Cancel (Esc)" />
      </Grid>

      <Border Classes="FeatureDialogHintCard">
        <TextBlock Classes="FeatureDialogHintText"
                   Text="Mirror copies the selected geometry across a reference plane. Choose the plane that should act as the symmetry boundary." />
      </Border>

      <Border Classes="FeatureDialogSectionCard">
        <StackPanel Spacing="0">
          <TextBlock Text="Mirror plane"
                     Classes="FeatureDialogFieldLabel"
                     Margin="0,0,0,6" />
          <ComboBox x:Name="AxisComboBox"
                    Classes="FeatureDialogInput"
                    HorizontalAlignment="Stretch"
                    SelectedIndex="0">
            <ComboBoxItem Content="Right (YZ) plane" Tag="x" />
            <ComboBoxItem Content="Front (XZ) plane" Tag="y" />
            <ComboBoxItem Content="Top (XY) plane" Tag="z" />
          </ComboBox>
        </StackPanel>
      </Border>

    </StackPanel>
  </Border>
</Window>
