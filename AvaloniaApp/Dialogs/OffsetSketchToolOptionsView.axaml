<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="My3DApp.AvaloniaApp.Dialogs.OffsetSketchToolOptionsView">
  <StackPanel Spacing="10">
    <Border Classes="FeatureDialogSectionCard">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="96,*">
        <TextBlock Text="Tool"
                   Classes="FeatureDialogFieldLabel" />
        <TextBlock Grid.Column="1"
                   Classes="FeatureDialogValueText"
                   Text="Offset" />
        <TextBlock Grid.Row="1"
                   Margin="0,10,0,0"
                   Text="Mode"
                   Classes="FeatureDialogFieldLabel" />
        <TextBlock Grid.Row="1"
                   Grid.Column="1"
                   Margin="0,10,0,0"
                   Classes="FeatureDialogValueText"
                   TextWrapping="Wrap"
                   Text="Click in the viewport to create a parallel offset copy of all current sketch lines and circles." />
      </Grid>
    </Border>

    <Border Classes="FeatureDialogSectionCard">
      <StackPanel Spacing="10">
        <TextBlock Text="Options"
                   Classes="FeatureDialogFieldLabel" />
        <Grid RowDefinitions="Auto" ColumnDefinitions="120,*">
          <TextBlock Classes="FeatureDialogFieldLabel"
                     Text="Distance (mm)"
                     VerticalAlignment="Center" />
          <NumericUpDown x:Name="DistanceInput"
                         Grid.Column="1"
                         Classes="FeatureDialogInput"
                         Minimum="-1000"
                         Maximum="1000"
                         Value="1"
                         Increment="0.5"
                         FormatString="0.###"
                         HorizontalAlignment="Stretch" />
        </Grid>
        <TextBlock Classes="FeatureDialogHelpText"
                   TextWrapping="Wrap"
                   Text="Negative values produce an inward offset. Lines and circles are supported." />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
