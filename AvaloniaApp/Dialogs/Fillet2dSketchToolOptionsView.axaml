<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="My3DApp.AvaloniaApp.Dialogs.Fillet2dSketchToolOptionsView">
  <StackPanel Spacing="10">
    <Border Classes="FeatureDialogSectionCard">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="96,*">
        <TextBlock Text="Tool"
                   Classes="FeatureDialogFieldLabel" />
        <TextBlock Grid.Column="1"
                   Classes="FeatureDialogValueText"
                   Text="2D Fillet" />
        <TextBlock Grid.Row="1"
                   Margin="0,10,0,0"
                   Text="Mode"
                   Classes="FeatureDialogFieldLabel" />
        <TextBlock Grid.Row="1"
                   Grid.Column="1"
                   Margin="0,10,0,0"
                   Classes="FeatureDialogValueText"
                   TextWrapping="Wrap"
                   Text="Click near the corner of two intersecting lines to insert a tangent arc." />
      </Grid>
    </Border>

    <Border Classes="FeatureDialogSectionCard">
      <StackPanel Spacing="10">
        <TextBlock Text="Options"
                   Classes="FeatureDialogFieldLabel" />
        <Grid RowDefinitions="Auto" ColumnDefinitions="120,*">
          <TextBlock Classes="FeatureDialogFieldLabel"
                     Text="Radius (mm)"
                     VerticalAlignment="Center" />
          <NumericUpDown x:Name="RadiusInput"
                         Grid.Column="1"
                         Classes="FeatureDialogInput"
                         Minimum="0.01"
                         Maximum="500"
                         Value="1"
                         Increment="0.5"
                         FormatString="0.###"
                         HorizontalAlignment="Stretch" />
        </Grid>
        <TextBlock Classes="FeatureDialogHelpText"
                   TextWrapping="Wrap"
                   Text="The fillet arc is computed between the last two line segments in the sketch." />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
