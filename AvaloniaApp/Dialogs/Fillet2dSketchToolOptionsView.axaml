<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="My3DApp.AvaloniaApp.Dialogs.Fillet2dSketchToolOptionsView">
  <StackPanel Spacing="10">
    <Border Background="{DynamicResource Studio.PanelInsetBrush}"
            BorderBrush="{DynamicResource Studio.BorderBrush}"
            BorderThickness="1"
            Padding="12">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="96,*">
        <TextBlock Text="Tool"
                   FontWeight="SemiBold" />
        <TextBlock Grid.Column="1"
                   Text="2D Fillet" />
        <TextBlock Grid.Row="1"
                   Margin="0,10,0,0"
                   Text="Mode"
                   FontWeight="SemiBold" />
        <TextBlock Grid.Row="1"
                   Grid.Column="1"
                   Margin="0,10,0,0"
                   Text="Click near the corner of two intersecting lines to insert a tangent arc."
                   TextWrapping="Wrap" />
      </Grid>
    </Border>

    <Border Background="{DynamicResource Studio.PanelInsetBrush}"
            BorderBrush="{DynamicResource Studio.BorderBrush}"
            BorderThickness="1"
            Padding="12">
      <StackPanel Spacing="10">
        <TextBlock Text="Options"
                   FontWeight="SemiBold" />
        <Grid RowDefinitions="Auto" ColumnDefinitions="120,*">
          <TextBlock Text="Radius (mm)"
                     VerticalAlignment="Center" />
          <NumericUpDown x:Name="RadiusInput"
                         Grid.Column="1"
                         Minimum="0.01"
                         Maximum="500"
                         Value="1"
                         Increment="0.5"
                         FormatString="0.###"
                         HorizontalAlignment="Stretch" />
        </Grid>
        <TextBlock Text="The fillet arc is computed between the last two line segments in the sketch."
                   Foreground="{DynamicResource Studio.TextMutedBrush}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
