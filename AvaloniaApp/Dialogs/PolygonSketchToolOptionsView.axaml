<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="My3DApp.AvaloniaApp.Dialogs.PolygonSketchToolOptionsView">
  <StackPanel Spacing="10">
    <Border Classes="FeatureDialogSectionCard">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="96,*">
        <TextBlock Text="Tool"
                   Classes="FeatureDialogFieldLabel" />
        <TextBlock Grid.Column="1"
                   Classes="FeatureDialogValueText"
                   Text="Polygon" />
        <TextBlock Grid.Row="1"
                   Margin="0,10,0,0"
                   Text="Mode"
                   Classes="FeatureDialogFieldLabel" />
        <TextBlock Grid.Row="1"
                   Grid.Column="1"
                   Margin="0,10,0,0"
                   Classes="FeatureDialogValueText"
                   TextWrapping="Wrap"
                   Text="Click center, then drag to set radius." />
      </Grid>
    </Border>

    <Border Classes="FeatureDialogSectionCard">
      <StackPanel Spacing="10">
        <TextBlock Text="Options"
                   Classes="FeatureDialogFieldLabel" />
        <Grid RowDefinitions="Auto" ColumnDefinitions="120,*">
          <TextBlock Classes="FeatureDialogFieldLabel"
                     Text="Sides (n)"
                     VerticalAlignment="Center" />
          <NumericUpDown x:Name="SidesInput"
                         Grid.Column="1"
                         Classes="FeatureDialogInput"
                         Minimum="3"
                         Maximum="50"
                         Value="6"
                         Increment="1"
                         FormatString="0"
                         HorizontalAlignment="Stretch" />
        </Grid>
        <TextBlock Classes="FeatureDialogHelpText"
                   TextWrapping="Wrap"
                   Text="Valid range: 3 to 50 sides. Default is 6 (hexagon)." />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
