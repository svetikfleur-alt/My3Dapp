<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="My3DApp.AvaloniaApp.Dialogs.ExtrudeFeatureDialog"
        Width="400"
        Height="370"
        MinWidth="370"
        MinHeight="340"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Classes="FeatureDialogWindow"
        Title="Extrude">
  <Border Classes="FeatureDialogPanel" Margin="0">
    <StackPanel Margin="16,14,16,16" Classes="FeatureDialogBodyStack">

      <Grid Classes="FeatureDialogHeaderBar" ColumnDefinitions="*,Auto,Auto">
        <TextBlock Classes="FeatureDialogTitle"
                   Text="Extrude"
                   VerticalAlignment="Center" />
        <Button x:Name="OkButton"
                Grid.Column="1"
                Classes="FeatureDialogConfirmBtn"
                IsDefault="True"
                Click="OnConfirmClick"
                ToolTip.Tip="Confirm (Enter)" />
        <Button Grid.Column="2"
                Margin="6,0,0,0"
                Classes="FeatureDialogCancelBtn"
                IsCancel="True"
                Click="OnCancelClick"
                ToolTip.Tip="Cancel (Esc)" />
      </Grid>

      <Border Classes="FeatureDialogHintCard">
        <TextBlock Classes="FeatureDialogHintText"
                   Text="Pick one closed normal sketch profile, set the depth, then choose whether this should create a new body or modify an existing one." />
      </Border>

      <Border Classes="FeatureDialogTabBar">
        <StackPanel Orientation="Horizontal" Spacing="0">
          <ToggleButton x:Name="OpNewTab"
                        Classes="FeatureDialogOperationTab"
                        Content="New"
                        IsChecked="True"
                        Click="OnOperationTabClicked" />
          <ToggleButton x:Name="OpAddTab"
                        Classes="FeatureDialogOperationTab"
                        Content="Add"
                        Click="OnOperationTabClicked" />
          <ToggleButton x:Name="OpRemoveTab"
                        Classes="FeatureDialogOperationTab"
                        Content="Remove"
                        Click="OnOperationTabClicked" />
          <ToggleButton x:Name="OpSymmetricTab"
                        Classes="FeatureDialogOperationTab"
                        Content="Symmetric"
                        Click="OnOperationTabClicked" />
        </StackPanel>
      </Border>

      <!-- Profile selection field -->
      <TextBlock Classes="FeatureDialogFieldLabel"
                 Text="Faces and sketch regions to extrude"
                 Margin="0,0,0,4" />
      <Border Classes="FeatureDialogSelectionField">
        <TextBlock x:Name="ProfileValueTextBlock"
                   Classes="FeatureDialogSelectionText"
                   Text="Select a closed sketch profile" />
      </Border>

      <!-- Target body (Add/Remove ops only) -->
      <TextBlock x:Name="TargetBodyLabel"
                 Classes="FeatureDialogFieldLabel"
                 Text="Target body"
                 IsVisible="False"
                 Margin="0,0,0,4" />
      <ComboBox x:Name="TargetBodyComboBox"
                Classes="FeatureDialogInput"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,2"
                IsVisible="False" />
      <TextBlock x:Name="NoBodyWarningText"
                 Text="No bodies available."
                 Foreground="OrangeRed"
                 FontSize="11"
                 TextWrapping="Wrap"
                 Margin="0,0,0,2"
                 IsVisible="False" />

      <!-- Parameters -->
      <Border Classes="FeatureDialogSectionCard">
        <Grid ColumnDefinitions="*,72" RowDefinitions="Auto,Auto,Auto">
          <TextBlock Text="Depth"
                     Classes="FeatureDialogFieldLabel" />
          <NumericUpDown x:Name="DistanceInput"
                         Classes="FeatureDialogInput"
                         Grid.Row="1"
                         Width="150"
                         HorizontalAlignment="Left"
                         Margin="0,6,0,0"
                         Increment="1"
                         Minimum="0.2"
                         Maximum="5000"
                         FormatString="0.###" />
          <Border Grid.Column="1"
                  Grid.Row="1"
                  Classes="FeatureDialogUnitChip"
                  Margin="8,6,0,0"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Top">
            <TextBlock HorizontalAlignment="Center" Text="mm" />
          </Border>

          <CheckBox x:Name="ReverseDirectionCheckBox"
                    Classes="FeatureDialogCheckBox"
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Content="Reverse direction"
                    Margin="0,10,0,0" />
        </Grid>
      </Border>

    </StackPanel>
  </Border>
</Window>
