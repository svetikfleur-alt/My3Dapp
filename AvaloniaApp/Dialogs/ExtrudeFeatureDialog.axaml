<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="My3DApp.AvaloniaApp.Dialogs.ExtrudeFeatureDialog"
        Width="460"
        Height="470"
        MinWidth="430"
        MinHeight="440"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Classes="FeatureDialogWindow"
        Title="Extrude">
  <Border Classes="FeatureDialogPanel" Margin="0">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="18">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Classes="FeatureDialogTitle"
                     Text="Extrude" />
          <TextBlock Classes="FeatureDialogSubtitle"
                     TextWrapping="Wrap"
                     Text="Create a solid from a selected closed sketch profile." />
        </StackPanel>
        <Border Grid.Column="1"
                Background="{DynamicResource Studio.PanelInsetBrush}"
                BorderBrush="{DynamicResource Studio.BorderBrush}"
                BorderThickness="1"
                Padding="9,5"
                VerticalAlignment="Top">
          <TextBlock Text="FEATURE"
                     FontSize="10"
                     FontWeight="SemiBold" />
        </Border>
      </Grid>

      <StackPanel Grid.Row="2"
                  Margin="0,16,0,16"
                  Spacing="12">
        <Border Background="{DynamicResource Studio.PanelInsetBrush}"
                BorderBrush="{DynamicResource Studio.BorderBrush}"
                BorderThickness="1"
                Padding="12">
          <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="104,*">
            <TextBlock Text="Profile"
                       FontWeight="SemiBold" />
            <TextBlock Grid.Column="1"
                       x:Name="ProfileValueTextBlock"
                       TextWrapping="Wrap"
                       Text="Closed sketch profile" />
            <TextBlock Grid.Row="1"
                       Text="Plane"
                       Margin="0,10,0,0"
                       FontWeight="SemiBold" />
            <TextBlock Grid.Row="1"
                       Grid.Column="1"
                       x:Name="PlaneValueTextBlock"
                       Margin="0,10,0,0"
                       Text="Top" />
            <TextBlock Grid.Row="2"
                       Text="Status"
                       Margin="0,10,0,0"
                       FontWeight="SemiBold" />
            <TextBlock Grid.Row="2"
                       Grid.Column="1"
                       x:Name="SelectionStatusTextBlock"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap"
                       Text="Ready" />
          </Grid>
        </Border>

        <Border Background="{DynamicResource Studio.PanelInsetBrush}"
                BorderBrush="{DynamicResource Studio.BorderBrush}"
                BorderThickness="1"
                Padding="12">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="104,*">
            <TextBlock Text="Operation"
                       FontWeight="SemiBold" />
            <ComboBox Grid.Column="1"
                      x:Name="OperationComboBox"
                      SelectionChanged="OnOperationChanged"
                      SelectedIndex="0">
              <ComboBoxItem Content="New Body" Tag="NewBody" />
              <ComboBoxItem Content="Join" Tag="Join" />
              <ComboBoxItem Content="Cut" Tag="Cut" />
              <ComboBoxItem Content="Symmetric" Tag="Symmetric" />
            </ComboBox>

            <TextBlock Grid.Row="1"
                       Margin="0,10,0,0"
                       Foreground="{DynamicResource Studio.TextMutedBrush}"
                       Text="Result"
                       FontWeight="SemiBold" />
            <TextBlock Grid.Row="1"
                       Grid.Column="1"
                       x:Name="OperationHelpTextBlock"
                       Margin="0,10,0,0"
                       Foreground="{DynamicResource Studio.TextMutedBrush}"
                       TextWrapping="Wrap"
                       Text="Creates a separate solid body." />

            <TextBlock Grid.Row="2"
                       x:Name="TargetBodyLabel"
                       Text="Target Body"
                       Margin="0,10,0,0"
                       FontWeight="SemiBold"
                       IsVisible="False" />
            <ComboBox Grid.Row="2"
                      Grid.Column="1"
                      x:Name="TargetBodyComboBox"
                      Margin="0,8,0,0"
                      IsVisible="False" />
            <TextBlock Grid.Row="3"
                       Grid.ColumnSpan="2"
                       x:Name="NoBodyWarningText"
                       Text="No bodies to join/cut. Create a body first."
                       Foreground="OrangeRed"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"
                       IsVisible="False" />
          </Grid>
        </Border>

        <Border Background="{DynamicResource Studio.PanelInsetBrush}"
                BorderBrush="{DynamicResource Studio.BorderBrush}"
                BorderThickness="1"
                Padding="12">
          <Grid ColumnDefinitions="*,88" RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock Text="Distance"
                       FontWeight="SemiBold" />
            <NumericUpDown x:Name="DistanceInput"
                           Grid.Row="1"
                           Width="160"
                           HorizontalAlignment="Left"
                           Margin="0,8,0,0"
                           Increment="1"
                           Minimum="0.2"
                           Maximum="5000"
                           FormatString="0.###" />
            <Border Grid.Column="1"
                    Grid.Row="1"
                    Margin="8,8,0,0"
                    Background="{DynamicResource Studio.PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource Studio.BorderBrush}"
                    BorderThickness="1"
                    Padding="10,6"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top">
              <TextBlock HorizontalAlignment="Center"
                         Text="mm" />
            </Border>

            <CheckBox Grid.Row="2"
                      Grid.ColumnSpan="2"
                      x:Name="ReverseDirectionCheckBox"
                      Margin="0,12,0,0"
                      Content="Reverse direction" />
            <TextBlock Grid.Row="3"
                       Grid.ColumnSpan="2"
                       Margin="0,8,0,0"
                       Foreground="{DynamicResource Studio.TextMutedBrush}"
                       TextWrapping="Wrap"
                       Text="OK creates the feature. Cancel leaves the sketch/body unchanged." />
          </Grid>
        </Border>
      </StackPanel>

      <StackPanel Grid.Row="3"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="8">
        <Button Content="Cancel"
                Classes="FeatureDialogButtonSecondary"
                Click="OnCancelClick" />
        <Button x:Name="OkButton"
                Content="OK"
                Classes="FeatureDialogButtonPrimary"
                Click="OnConfirmClick" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
