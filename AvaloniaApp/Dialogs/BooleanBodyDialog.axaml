<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="My3DApp.AvaloniaApp.Dialogs.BooleanBodyDialog"
        Width="420"
        Height="340"
        MinWidth="380"
        MinHeight="310"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Classes="FeatureDialogWindow"
        Title="Boolean Body Operation">
  <Border Classes="FeatureDialogPanel" Margin="0">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="18">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Classes="FeatureDialogTitle"
                     Text="Boolean Body Operation" />
          <TextBlock Classes="FeatureDialogSubtitle"
                     TextWrapping="Wrap"
                     Text="Combine two solid bodies using a supported Boolean operation." />
        </StackPanel>
        <Border Grid.Column="1"
                Classes="FeatureDialogTag"
                VerticalAlignment="Top">
          <TextBlock Text="FEATURE"
                     Classes="FeatureDialogTagText" />
        </Border>
      </Grid>

      <StackPanel Grid.Row="2"
                  Margin="0,16,0,16"
                  Spacing="12">
        <Border Classes="FeatureDialogSectionCard">
          <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="80,*">
            <TextBlock Text="Body A"
                       Classes="FeatureDialogFieldLabel"
                       VerticalAlignment="Center" />
            <ComboBox x:Name="BodyAComboBox"
                      Classes="FeatureDialogInput"
                      Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      Margin="8,0,0,0" />

            <TextBlock Grid.Row="1"
                       Text="Body B"
                       Classes="FeatureDialogFieldLabel"
                       VerticalAlignment="Center"
                       Margin="0,10,0,0" />
            <ComboBox x:Name="BodyBComboBox"
                      Classes="FeatureDialogInput"
                      Grid.Row="1"
                      Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      Margin="8,10,0,0" />
          </Grid>
        </Border>

        <Border Classes="FeatureDialogSectionCard">
          <StackPanel Spacing="8">
            <TextBlock Text="Operation"
                       Classes="FeatureDialogFieldLabel" />
            <RadioButton x:Name="UnionRadio"
                         Classes="FeatureDialogCheckBox"
                         Content="Union — merge both bodies into one"
                         GroupName="BoolOp"
                         IsChecked="True" />
            <RadioButton x:Name="SubtractRadio"
                         Classes="FeatureDialogCheckBox"
                         Content="Subtract — cut Body B from Body A"
                         GroupName="BoolOp" />
            <RadioButton x:Name="IntersectRadio"
                         Classes="FeatureDialogCheckBox"
                         Content="Intersect — keep only the overlapping volume"
                         GroupName="BoolOp" />
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel Grid.Row="3"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="8">
        <Button Content="Cancel"
                Classes="FeatureDialogButtonSecondary"
                Click="OnCancelClick" />
        <Button Content="Apply"
                Classes="FeatureDialogButtonPrimary"
                Click="OnConfirmClick" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
