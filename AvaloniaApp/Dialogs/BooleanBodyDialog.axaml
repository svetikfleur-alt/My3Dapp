<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="My3DApp.AvaloniaApp.Dialogs.BooleanBodyDialog"
        Width="400"
        Height="310"
        MinWidth="370"
        MinHeight="280"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Classes="FeatureDialogWindow"
        Title="Boolean Operation">
  <Border Classes="FeatureDialogPanel" Margin="0">
    <StackPanel Margin="16,14,16,16" Spacing="0">

      <!-- Header -->
      <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
        <TextBlock Classes="FeatureDialogTitle" Text="Boolean Operation" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="FeatureDialogConfirmBtn" IsDefault="True" Click="OnConfirmClick" />
        <Button Grid.Column="2" Margin="6,0,0,0" Classes="FeatureDialogCancelBtn" IsCancel="True" Click="OnCancelClick" />
      </Grid>

      <!-- Operation tabs -->
      <Border Classes="FeatureDialogTabBar" Margin="0,0,0,10">
        <StackPanel Orientation="Horizontal" Spacing="0">
          <ToggleButton x:Name="UnionTab" Classes="FeatureDialogOperationTab" Content="Union" IsChecked="True" Click="OnOpTabClicked" />
          <ToggleButton x:Name="SubtractTab" Classes="FeatureDialogOperationTab" Content="Subtract" Click="OnOpTabClicked" />
          <ToggleButton x:Name="IntersectTab" Classes="FeatureDialogOperationTab" Content="Intersect" Click="OnOpTabClicked" />
        </StackPanel>
      </Border>

      <!-- Body A -->
      <TextBlock Classes="FeatureDialogFieldLabel" Text="Body A" Margin="0,0,0,4" />
      <ComboBox x:Name="BodyAComboBox"
                Classes="FeatureDialogInput"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,8" />

      <!-- Body B -->
      <TextBlock Classes="FeatureDialogFieldLabel" Text="Body B" Margin="0,0,0,4" />
      <ComboBox x:Name="BodyBComboBox"
                Classes="FeatureDialogInput"
                HorizontalAlignment="Stretch" />

    </StackPanel>
  </Border>
</Window>
