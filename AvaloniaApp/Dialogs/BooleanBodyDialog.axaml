<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="My3DApp.AvaloniaApp.Dialogs.BooleanBodyDialog"
        Width="420"
        Height="320"
        MinWidth="380"
        MinHeight="290"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Classes="FeatureDialogWindow"
        Title="Boolean Body Operation">
  <Border Classes="FeatureDialogPanel" Margin="0">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="18">
      <TextBlock Classes="FeatureDialogTitle"
                 Text="Boolean Body Operation" />
      <TextBlock Grid.Row="1"
                 Margin="0,6,0,0"
                 Classes="FeatureDialogSubtitle"
                 Text="Combine two solid bodies using a supported Boolean operation." />

      <StackPanel Grid.Row="2"
                  Margin="0,16,0,16"
                  Spacing="12">
        <Border Background="{DynamicResource Studio.PanelInsetBrush}"
                BorderBrush="{DynamicResource Studio.BorderBrush}"
                BorderThickness="1"
                Padding="12">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="80,*">
            <TextBlock Text="Body A"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold" />
            <ComboBox x:Name="BodyAComboBox"
                      Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      Margin="8,0,0,0" />

            <TextBlock Grid.Row="1"
                       Text="Body B"
                       VerticalAlignment="Center"
                       Margin="0,10,0,0"
                       FontWeight="SemiBold" />
            <ComboBox x:Name="BodyBComboBox"
                      Grid.Row="1"
                      Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      Margin="8,10,0,0" />
          </Grid>
        </Border>

        <Border Background="{DynamicResource Studio.PanelInsetBrush}"
                BorderBrush="{DynamicResource Studio.BorderBrush}"
                BorderThickness="1"
                Padding="12">
          <StackPanel Spacing="4">
            <TextBlock Text="Operation"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6" />
            <RadioButton x:Name="UnionRadio"
                         Content="Union - merge both bodies into one"
                         GroupName="BoolOp"
                         IsChecked="True" />
            <RadioButton x:Name="SubtractRadio"
                         Content="Subtract — cut Body B from Body A"
                         GroupName="BoolOp"
                         ToolTip.Tip="Remove the volume of Body B from Body A." />
            <RadioButton x:Name="IntersectRadio"
                         Content="Intersect — keep only the overlapping volume"
                         GroupName="BoolOp"
                         ToolTip.Tip="Retain only the region shared by both bodies." />
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel Grid.Row="3"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="8">
        <Button Content="Cancel"
                Classes="FeatureDialogButtonSecondary"
                Click="OnCancelClick" />
        <Button Content="OK"
                Classes="FeatureDialogButtonPrimary"
                Click="OnConfirmClick" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
