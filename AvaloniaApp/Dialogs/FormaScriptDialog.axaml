<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="My3DApp.AvaloniaApp.Dialogs.FormaScriptDialog"
        Width="720"
        Height="560"
        MinWidth="520"
        MinHeight="360"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Classes="FeatureDialogWindow"
        Title="FormaScript Editor">

  <Border Classes="FeatureDialogPanel" Margin="0">
    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="16,14,16,16">

      <!-- Header -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
        <StackPanel Orientation="Vertical" Spacing="2">
          <TextBlock Classes="FeatureDialogTitle" Text="FormaScript" />
          <TextBlock FontSize="11"
                     Foreground="{DynamicResource Studio.TextSecondaryBrush}"
                     Text="Parametric CAD scripting — var, repeat, if, arithmetic, all CAD commands." />
        </StackPanel>
        <Button Grid.Column="1"
                x:Name="ExamplesButton"
                Content="Examples ▾"
                VerticalAlignment="Top"
                Click="OnExamplesClick"
                Padding="8,4"
                FontSize="11" />
      </Grid>

      <!-- Code editor -->
      <Border Grid.Row="1"
              BorderBrush="{DynamicResource Studio.BorderBrush}"
              BorderThickness="1"
              CornerRadius="4">
        <TextBox x:Name="ScriptEditor"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas,Menlo,monospace"
                 FontSize="13"
                 Padding="10"
                 Background="Transparent"
                 BorderThickness="0"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 KeyDown="OnEditorKeyDown" />
      </Border>

      <!-- Status / error line -->
      <Border Grid.Row="2"
              Margin="0,8,0,0"
              Padding="8,5"
              CornerRadius="4"
              IsVisible="{Binding !!StatusText.Length, ElementName=StatusText}"
              Background="{DynamicResource Studio.NotificationBackgroundBrush}">
        <TextBlock x:Name="StatusText"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Studio.TextSecondaryBrush}" />
      </Border>

      <!-- Buttons -->
      <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,10,0,0">
        <Button Grid.Column="0"
                x:Name="ClearButton"
                Content="Clear"
                Click="OnClearClick"
                Padding="10,5"
                FontSize="12" />
        <Button Grid.Column="2"
                Classes="FeatureDialogCancelBtn"
                IsCancel="True"
                Click="OnCancelClick" />
        <Button Grid.Column="3"
                Margin="8,0,0,0"
                Classes="FeatureDialogConfirmBtn"
                Content="Run Script"
                IsDefault="True"
                Click="OnRunClick" />
      </Grid>

    </Grid>
  </Border>
</Window>
