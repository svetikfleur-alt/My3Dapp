<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="My3DApp.AvaloniaApp.Dialogs.LineSketchToolOptionsView">
  <StackPanel Spacing="10">
    <Border Background="{DynamicResource Studio.PanelInsetBrush}"
            BorderBrush="{DynamicResource Studio.BorderBrush}"
            BorderThickness="1"
            Padding="12">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="96,*">
        <TextBlock Text="Tool"
                   FontWeight="SemiBold" />
        <TextBlock Grid.Column="1"
                   Text="Line" />
        <TextBlock Grid.Row="1"
                   Margin="0,10,0,0"
                   Text="Mode"
                   FontWeight="SemiBold" />
        <TextBlock Grid.Row="1"
                   Grid.Column="1"
                   Margin="0,10,0,0"
                   Text="Chained &#x2014; each click extends from the previous endpoint."
                   TextWrapping="Wrap" />
      </Grid>
    </Border>

    <Border Background="{DynamicResource Studio.PanelInsetBrush}"
            BorderBrush="{DynamicResource Studio.BorderBrush}"
            BorderThickness="1"
            Padding="12">
      <StackPanel Spacing="6">
        <TextBlock Text="Options"
                   FontWeight="SemiBold" />
        <TextBlock Text="No options. Confirm to begin placing line segments in the viewport."
                   Foreground="{DynamicResource Studio.TextMutedBrush}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
