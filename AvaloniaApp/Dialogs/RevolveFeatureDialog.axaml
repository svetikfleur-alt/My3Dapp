<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="My3DApp.AvaloniaApp.Dialogs.RevolveFeatureDialog"
        Width="400"
        Height="330"
        MinWidth="370"
        MinHeight="300"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Classes="FeatureDialogWindow"
        Title="Revolve">
  <Border Classes="FeatureDialogPanel" Margin="0">
    <StackPanel Margin="16,14,16,16" Spacing="0">

      <!-- Header: title + confirm/cancel -->
      <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
        <TextBlock Classes="FeatureDialogTitle"
                   Text="Revolve"
                   VerticalAlignment="Center" />
        <Button Grid.Column="1"
                Classes="FeatureDialogConfirmBtn"
                IsDefault="True"
                Click="OnConfirmClick"
                ToolTip.Tip="Confirm (Enter)" />
        <Button Grid.Column="2"
                Margin="6,0,0,0"
                Classes="FeatureDialogCancelBtn"
                IsCancel="True"
                Click="OnCancelClick"
                ToolTip.Tip="Cancel (Esc)" />
      </Grid>

      <!-- Profile selection field -->
      <TextBlock Classes="FeatureDialogFieldLabel"
                 Text="Faces and sketch regions to revolve"
                 Margin="0,0,0,4" />
      <Border Classes="FeatureDialogSelectionField" Margin="0,0,0,8">
        <TextBlock x:Name="ProfileValueTextBlock"
                   Classes="FeatureDialogSelectionText"
                   Text="Select a closed sketch profile" />
      </Border>

      <!-- Parameters -->
      <Border Classes="FeatureDialogSectionCard">
        <StackPanel Spacing="0">

          <!-- Revolve axis -->
          <TextBlock Text="Revolve axis"
                     Classes="FeatureDialogFieldLabel"
                     Margin="0,0,0,6" />
          <ComboBox x:Name="AxisComboBox"
                    Classes="FeatureDialogInput"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,10"
                    SelectedIndex="1">
            <ComboBoxItem Content="Sketch X axis" Tag="x" />
            <ComboBoxItem Content="Sketch Y axis" Tag="y" />
          </ComboBox>

          <!-- Full revolve checkbox -->
          <CheckBox x:Name="FullRevolveCheckBox"
                    Classes="FeatureDialogCheckBox"
                    Content="Full revolve"
                    IsChecked="True"
                    Checked="OnFullRevolveChanged"
                    Unchecked="OnFullRevolveChanged"
                    Margin="0,0,0,10" />

          <!-- Angle (hidden when full revolve) -->
          <Grid x:Name="AngleRow"
                ColumnDefinitions="*,72"
                IsVisible="False">
            <NumericUpDown x:Name="AngleInput"
                           Classes="FeatureDialogInput"
                           Width="150"
                           HorizontalAlignment="Left"
                           Increment="5"
                           Minimum="1"
                           Maximum="359"
                           FormatString="0.###" />
            <Border Grid.Column="1"
                    Classes="FeatureDialogUnitChip"
                    Margin="8,0,0,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top">
              <TextBlock HorizontalAlignment="Center" Text="deg" />
            </Border>
          </Grid>

        </StackPanel>
      </Border>

    </StackPanel>
  </Border>
</Window>
