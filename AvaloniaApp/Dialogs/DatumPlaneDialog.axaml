<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="My3DApp.AvaloniaApp.Dialogs.DatumPlaneDialog"
        Title="Datum Plane"
        Width="380"
        Height="270"
        MinWidth="350"
        MinHeight="250"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Classes="FeatureDialogWindow">
  <Border Classes="FeatureDialogPanel" Margin="0">
    <StackPanel Margin="16,14,16,16" Spacing="0">

      <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
        <TextBlock Classes="FeatureDialogTitle" Text="Datum Plane" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="FeatureDialogConfirmBtn" IsDefault="True" Click="OnCreateClick" />
        <Button Grid.Column="2" Margin="6,0,0,0" Classes="FeatureDialogCancelBtn" IsCancel="True" Click="OnCancelClick" />
      </Grid>

      <Border Classes="FeatureDialogSectionCard">
        <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">

          <TextBlock Text="Source plane" Classes="FeatureDialogFieldLabel" VerticalAlignment="Center" />
          <ComboBox Grid.Column="1"
                    x:Name="SourcePlaneCombo"
                    Classes="FeatureDialogInput"
                    HorizontalAlignment="Stretch">
            <ComboBoxItem Content="Top" Tag="Top" />
            <ComboBoxItem Content="Front" Tag="Front" />
            <ComboBoxItem Content="Right" Tag="Right" />
          </ComboBox>

          <TextBlock Grid.Row="1" Text="Offset" Classes="FeatureDialogFieldLabel" VerticalAlignment="Center" Margin="0,10,0,0" />
          <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,60" Margin="0,8,0,0">
            <NumericUpDown x:Name="OffsetInput"
                           Classes="FeatureDialogInput"
                           Value="10"
                           Minimum="-10000"
                           Maximum="10000"
                           Increment="1"
                           FormatString="0.##"
                           HorizontalAlignment="Stretch" />
            <Border Grid.Column="1"
                    Classes="FeatureDialogUnitChip"
                    Margin="8,0,0,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
              <TextBlock HorizontalAlignment="Center" Text="mm" />
            </Border>
          </Grid>

          <TextBlock Grid.Row="2" Text="Name" Classes="FeatureDialogFieldLabel" VerticalAlignment="Center" Margin="0,10,0,0" />
          <TextBox Grid.Row="2" Grid.Column="1"
                   x:Name="NameInput"
                   Watermark="Optional custom name"
                   Classes="AssistantKeyInput"
                   HorizontalAlignment="Stretch"
                   Margin="0,8,0,0" />

        </Grid>
      </Border>

    </StackPanel>
  </Border>
</Window>
