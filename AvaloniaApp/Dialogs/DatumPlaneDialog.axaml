<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="My3DApp.AvaloniaApp.Dialogs.DatumPlaneDialog"
        Title="Create Datum Plane"
        Width="360"
        Height="240"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <StackPanel Margin="20" Spacing="14">
    <TextBlock Text="Create Datum Plane — Offset Method"
               FontWeight="SemiBold"
               FontSize="13" />

    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Source plane"
                 VerticalAlignment="Center" />
      <ComboBox Grid.Row="0" Grid.Column="1"
                x:Name="SourcePlaneCombo"
                HorizontalAlignment="Stretch">
        <ComboBoxItem Content="Top" Tag="Top" />
        <ComboBoxItem Content="Front" Tag="Front" />
        <ComboBoxItem Content="Right" Tag="Right" />
      </ComboBox>

      <TextBlock Grid.Row="1" Grid.Column="0" Text="Offset (mm)"
                 VerticalAlignment="Center"
                 Margin="0,10,0,0" />
      <NumericUpDown Grid.Row="1" Grid.Column="1"
                     x:Name="OffsetInput"
                     Value="10"
                     Minimum="-10000"
                     Maximum="10000"
                     Increment="1"
                     FormatString="0.##"
                     HorizontalAlignment="Stretch"
                     Margin="0,10,0,0" />

      <TextBlock Grid.Row="2" Grid.Column="0" Text="Name"
                 VerticalAlignment="Center"
                 Margin="0,10,0,0" />
      <TextBox Grid.Row="2" Grid.Column="1"
               x:Name="NameInput"
               HorizontalAlignment="Stretch"
               Margin="0,10,0,0" />
    </Grid>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
      <Button Content="Cancel"
              Classes="FeatureDialogButtonSecondary"
              Click="OnCancelClick" />
      <Button Content="Create"
              Classes="FeatureDialogButtonPrimary"
              Click="OnCreateClick"
              IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
