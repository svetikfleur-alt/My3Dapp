<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="My3DApp.AvaloniaApp.Dialogs.PointSketchToolOptionsView">
  <StackPanel Spacing="10">
    <Border Background="{DynamicResource Studio.PanelInsetBrush}"
            BorderBrush="{DynamicResource Studio.BorderBrush}"
            BorderThickness="1"
            Padding="12">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="96,*">
        <TextBlock Text="Tool"
                   FontWeight="SemiBold" />
        <TextBlock Grid.Column="1"
                   Text="Point" />
        <TextBlock Grid.Row="1"
                   Margin="0,10,0,0"
                   Text="Mode"
                   FontWeight="SemiBold" />
        <TextBlock Grid.Row="1"
                   Grid.Column="1"
                   Margin="0,10,0,0"
                   Text="Click in the viewport to place a construction point, or type coordinates below."
                   TextWrapping="Wrap" />
      </Grid>
    </Border>

    <Border Background="{DynamicResource Studio.PanelInsetBrush}"
            BorderBrush="{DynamicResource Studio.BorderBrush}"
            BorderThickness="1"
            Padding="12">
      <StackPanel Spacing="8">
        <TextBlock Text="Direct entry (optional)"
                   FontWeight="SemiBold" />
        <Grid ColumnDefinitions="56,*,12,56,*" RowDefinitions="Auto">
          <TextBlock Text="X" VerticalAlignment="Center" FontWeight="SemiBold" />
          <NumericUpDown x:Name="XInput"
                         Grid.Column="1"
                         Value="0"
                         Minimum="-99999"
                         Maximum="99999"
                         FormatString="0.###"
                         Classes="FeaturePanelInput" />
          <TextBlock Grid.Column="2" />
          <TextBlock Grid.Column="3" Text="Y" VerticalAlignment="Center" FontWeight="SemiBold" />
          <NumericUpDown x:Name="YInput"
                         Grid.Column="4"
                         Value="0"
                         Minimum="-99999"
                         Maximum="99999"
                         FormatString="0.###"
                         Classes="FeaturePanelInput" />
        </Grid>
        <TextBlock Text="Leave at 0,0 to place by clicking the viewport after confirming."
                   Foreground="{DynamicResource Studio.TextMutedBrush}"
                   FontSize="11"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
