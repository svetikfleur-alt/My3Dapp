<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{7E1B3A52-9C4D-4F86-B2E1-0A3D5C7F9E21}</ProjectGuid>
    <Keyword>ManagedCProj</Keyword>
    <RootNamespace>My3DAppOcct</RootNamespace>
    <ProjectName>My3DApp.Occt</ProjectName>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <!-- OCCT SDK location; override with /p:OcctRoot=... -->
    <OcctRoot Condition="'$(OcctRoot)' == ''">D:\My3DApp\sdk\occt-7.9.0\occt-vc144-64</OcctRoot>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <CLRSupport>NetCore</CLRSupport>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <OutDir>$(ProjectDir)bin\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)obj\$(Configuration)\</IntDir>
    <!-- Framework MSBuild (Build Tools) lacks the .NET workload resolver; reference
         the installed ref pack directly instead of implicit FrameworkReference resolution. -->
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <DotNetRefPack Condition="'$(DotNetRefPack)' == ''">C:\Program Files\dotnet\packs\Microsoft.NETCore.App.Ref\10.0.8\ref\net10.0</DotNetRefPack>
    <DotNetHostPack Condition="'$(DotNetHostPack)' == ''">C:\Program Files\dotnet\packs\Microsoft.NETCore.App.Host.win-x64\10.0.8\runtimes\win-x64\native</DotNetHostPack>
    <IjwHostSourcePath>$(DotNetHostPack)\Ijwhost.dll</IjwHostSourcePath>
    <!-- Loaded only into an already-running .NET app; no own runtimeconfig needed. -->
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>
  <ItemGroup>
    <ReferencePath Include="$(DotNetRefPack)\*.dll" />
  </ItemGroup>
  <!-- Ijwhost.dll normally flows from the runtime pack; copy it from the host pack instead. -->
  <Target Name="CopyIjwHost" AfterTargets="Build">
    <Copy SourceFiles="$(DotNetHostPack)\Ijwhost.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(OcctRoot)\inc;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WNT;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <WarningLevel>Level3</WarningLevel>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(OcctRoot)\win64\vc14\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>TKernel.lib;TKMath.lib;TKG2d.lib;TKG3d.lib;TKGeomBase.lib;TKGeomAlgo.lib;TKBRep.lib;TKTopAlgo.lib;TKPrim.lib;TKBO.lib;TKBool.lib;TKShHealing.lib;TKMesh.lib;TKService.lib;TKV3d.lib;TKOpenGl.lib;TKHLR.lib;TKDE.lib;TKXSBase.lib;TKDESTEP.lib;user32.lib;gdi32.lib;opengl32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <SubSystem>Windows</SubSystem>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="OcctCore.cpp">
      <CompileAsManaged>false</CompileAsManaged>
      <ExceptionHandling>Sync</ExceptionHandling>
    </ClCompile>
    <ClCompile Include="Bridge.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="OcctCore.h" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
